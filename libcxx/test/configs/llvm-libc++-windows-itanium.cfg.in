# This testing configuration handles running the test suite against LLVM's libc++
# using either a DLL or a static library, with Clang targeting Windows Itanium or
# NT-POSIX.

config.substitutions.append(('%{flags}', ''))
config.substitutions.append(('%{compile_flags}',
    '-nostdinc++ -I %{target-include-dir} -I %{include-dir} -I %{libcxx-dir}/test/support -D_CRT_SECURE_NO_WARNINGS -D_CRT_NONSTDC_NO_WARNINGS -DNOMINMAX'
))
config.substitutions.append(('%{link_flags}',
    '-nostdlib++ -L %{lib-dir} -lc++'
))

# Every image of Windows Itanium imports the process's termination registries
# from clang_rt.wincrt_dynamic.dll, in the compiler's runtime directory.
import subprocess
runtime_dir = subprocess.check_output(
    ['@CMAKE_CXX_COMPILER@', '--target=@CMAKE_CXX_COMPILER_TARGET@',
     '-print-runtime-dir'], text=True).strip().replace('\\', '/')
config.substitutions.append(('%{exec}',
    '%{executor} --execdir %{temp} --prepend_env '
    '"PATH=%{install-prefix}/bin;' + runtime_dir + '" -- '
))

import os, site
site.addsitedir(os.path.join('@LIBCXX_SOURCE_DIR@', 'utils'))
import libcxx.test.params, libcxx.test.config
libcxx.test.config.configure(
    libcxx.test.params.DEFAULT_PARAMETERS,
    libcxx.test.features.DEFAULT_FEATURES,
    config,
    lit_config
)
