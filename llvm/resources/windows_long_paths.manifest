<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Opt every LLVM executable in to paths longer than MAX_PATH (Windows 10
  1607+). Together with the LongPathsEnabled policy this lifts the 260
  character limit for the Win32 APIs that cannot take a "\\?\" prefixed path,
  such as SetCurrentDirectory and SearchPath; the "\\?\" prefixing in
  llvm::sys::windows::widenPath remains the fallback when the policy is off.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
