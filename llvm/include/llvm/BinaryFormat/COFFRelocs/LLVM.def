// The relocation types of AMD64 and ARM64 objects that only LLD applies:
// COFF_LLVM_RELOC(Name, Value, Props, Use), where Props are COFF::LLVMReloc's
// machines and properties of the type, and Use is the COFF::FusedUse of a type
// that marks a fused site.

#ifndef COFF_LLVM_RELOC
#error "COFF_LLVM_RELOC must be defined"
#endif

COFF_LLVM_RELOC(ADDR32NB_CALL, 0x8000, Both, None)
COFF_LLVM_RELOC(REL32_CALL, 0x8001, Both, None)
COFF_LLVM_RELOC(BRANCH_TAIL, 0x8002, Both | Resizes, None)
COFF_LLVM_RELOC(ALIGN, 0x8003, Both | NoSymbol | Resizes, None)
COFF_LLVM_RELOC(SSPAN_EPILOGV2, 0x8004, AMD64, None)
COFF_LLVM_RELOC(SSPAN8, 0x8010, Both, None)
COFF_LLVM_RELOC(SSPAN16, 0x8011, Both, None)
COFF_LLVM_RELOC(SSPAN32, 0x8012, ARM64, None)
COFF_LLVM_RELOC(SSPAN64, 0x8013, Both, None)
COFF_LLVM_RELOC(SSPAN_ULEB, 0x8014, Both, None)
COFF_LLVM_RELOC(SSPAN_SLEB, 0x8015, Both, None)
COFF_LLVM_RELOC(SSPAN_WORDS18, 0x8016, ARM64, None)
COFF_LLVM_RELOC(USPAN8, 0x8017, Both, None)
COFF_LLVM_RELOC(USPAN16, 0x8018, Both, None)
COFF_LLVM_RELOC(USPAN8_W, 0x8019, ARM64, None)
COFF_LLVM_RELOC(USPAN16_W, 0x801A, ARM64, None)
COFF_LLVM_RELOC(BRANCH32, 0x8020, AMD64, None)
COFF_LLVM_RELOC(JUMP32, 0x8021, AMD64 | Resizes, None)
COFF_LLVM_RELOC(JUMP8, 0x8022, AMD64 | Resizes, None)
COFF_LLVM_RELOC(MEM_CALL, 0x8023, AMD64 | Resizes, None)
COFF_LLVM_RELOC(MEM_JUMP, 0x8024, AMD64 | Resizes, None)
COFF_LLVM_RELOC(MEM_JUMP_P1, 0x8025, AMD64 | Resizes, None)
COFF_LLVM_RELOC(MEM_LOAD, 0x8026, AMD64 | Address, None)
COFF_LLVM_RELOC(MEM_LOAD_REX2, 0x8027, AMD64 | Address, None)
COFF_LLVM_RELOC(LEA, 0x8028, AMD64 | Address, None)
COFF_LLVM_RELOC(LEA_OFFSET, 0x8029, AMD64 | Address, None)
COFF_LLVM_RELOC(MEM_JUMP_TAIL, 0x802A, AMD64 | Resizes, None)
COFF_LLVM_RELOC(LEA_NARROW, 0x802B, AMD64 | Address, None)
COFF_LLVM_RELOC(MEM_LOAD_CALL, 0x802C, AMD64 | Resizes, None)
COFF_LLVM_RELOC(LEA_REX2, 0x802D, AMD64 | Address, None)
COFF_LLVM_RELOC(LEA_OFFSET_REX2, 0x802E, AMD64 | Address, None)
COFF_LLVM_RELOC(MOVW_UABS_G0, 0x8030, ARM64 | Address, None)
COFF_LLVM_RELOC(MOVW_UABS_G0_NC, 0x8031, ARM64 | Address, None)
COFF_LLVM_RELOC(MOVW_UABS_G1, 0x8032, ARM64 | Address, None)
COFF_LLVM_RELOC(LOGIMM, 0x8033, ARM64 | Address, None)
COFF_LLVM_RELOC(PAGEOFFSET_12L_IF_LOCAL, 0x8034, ARM64 | Fused, Access)
COFF_LLVM_RELOC(PAGEOFFSET_12A_IF_LOCAL, 0x8035, ARM64 | Fused, Add)
COFF_LLVM_RELOC(FUSED_CALL, 0x8040, ARM64 | Fused, Call)
COFF_LLVM_RELOC(FUSED_JUMP, 0x8041, ARM64 | Fused, Jump)
COFF_LLVM_RELOC(FUSED_READ, 0x8042, Both | Resizes | Moves | Fused, None)
COFF_LLVM_RELOC(FUSED_READ_REX2, 0x8043, AMD64 | Resizes | Moves | Fused, None)
COFF_LLVM_RELOC(FUSED_ACCESS, 0x8044, AMD64 | Resizes | Moves | Fused, Access)
COFF_LLVM_RELOC(FUSED_INDEX, 0x8045, Both | Moves | Fused, Index)
COFF_LLVM_RELOC(FUSED_TEST, 0x8046, Both | Resizes | Moves | Fused, Test)
COFF_LLVM_RELOC(FUSED_JUMP_TAIL, 0x8047, ARM64 | Resizes | Fused, Jump)
COFF_LLVM_RELOC(FUSED_ADD, 0x8048,
                AMD64 | NoSymbol | Resizes | Moves | Fused, Add)
COFF_LLVM_RELOC(FUSED_TEST_REG, 0x8049, AMD64 | Resizes | Moves | Fused, Test)
COFF_LLVM_RELOC(FUSED_BLOCK, 0x804A, Both | Resizes | Moves | Fused, None)
COFF_LLVM_RELOC(TPOFF32, 0x8050, AMD64, None)
COFF_LLVM_RELOC(TPOFF_HIGH12A, 0x8051, ARM64, None)
COFF_LLVM_RELOC(TPOFF_LOW12A_NC, 0x8052, ARM64, None)
COFF_LLVM_RELOC(TPOFF_LOW12L_NC, 0x8053, ARM64, None)
COFF_LLVM_RELOC(TLS_BASE, 0x8054, Both | NoSymbol | Resizes | Moves, None)
