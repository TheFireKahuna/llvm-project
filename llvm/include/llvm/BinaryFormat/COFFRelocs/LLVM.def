COFF_LLVM_RELOC(GOTTPOFF_PAGE21, 0x8056, ARM64, None)
COFF_LLVM_RELOC(GOTTPOFF_LOW12L, 0x8057, ARM64, None)
COFF_LLVM_RELOC(TPOFF_LOW12A, 0x8058, ARM64, None)
COFF_LLVM_RELOC(TPOFF_LOW12L, 0x8059, ARM64, None)
COFF_LLVM_RELOC(DTPOFF_LOW12A, 0x805A, ARM64, None)
COFF_LLVM_RELOC(DTPOFF_LOW12L, 0x805B, ARM64, None)
