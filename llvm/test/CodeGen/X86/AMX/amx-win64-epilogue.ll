; RUN: llc -mtriple=x86_64-pc-windows-msvc -mattr=+amx-tile < %s | FileCheck %s

; Windows' unwinder takes an address for an epilogue's only where the stack
; release and the pops run straight into the return, and version 2 unwind
; info, required here, describes no other epilogue: the tilerelease goes
; ahead of the epilogue.

declare x86_amx @llvm.x86.tilezero.internal(i16, i16)
declare void @llvm.x86.tilestored64.internal(i16, i16, ptr, i64, x86_amx)
declare void @g()

define void @f(ptr %buf) {
; CHECK-LABEL: f:
; CHECK:       # %bb.0:
; CHECK-NEXT:    .seh_unwindversion 2
; CHECK-NEXT:    pushq %rsi
; CHECK-NEXT:    .seh_pushreg %rsi
; CHECK-NEXT:    subq $96, %rsp
; CHECK-NEXT:    .seh_stackalloc 96
; CHECK-NEXT:    .seh_endprologue
; CHECK-NEXT:    movq %rcx, %rsi
; CHECK-NEXT:    xorps %xmm0, %xmm0
; CHECK-NEXT:    movups %xmm0, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    movups %xmm0, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    movups %xmm0, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    movups %xmm0, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    movb $1, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    movb $8, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    movw $32, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    callq g
; CHECK-NEXT:    ldtilecfg {{[0-9]+}}(%rsp)
; CHECK-NEXT:    movw $32, %ax
; CHECK-NEXT:    movw $8, %cx
; CHECK-NEXT:    tilezero %tmm0
; CHECK-NEXT:    movl $1024, %edx # imm = 0x400
; CHECK-NEXT:    tilestored %tmm0, (%rsi,%rdx)
; CHECK-NEXT:    tilerelease
; CHECK-NEXT:    .seh_startepilogue
; CHECK-NEXT:    addq $96, %rsp
; CHECK-NEXT:    .seh_unwindv2start
; CHECK-NEXT:    popq %rsi
; CHECK-NEXT:    .seh_endepilogue
; CHECK-NEXT:    retq
; CHECK-NEXT:    .seh_endproc
  call void @g()
  %t = call x86_amx @llvm.x86.tilezero.internal(i16 8, i16 32)
  call void @llvm.x86.tilestored64.internal(i16 8, i16 32, ptr %buf, i64 1024, x86_amx %t)
  ret void
}

!llvm.module.flags = !{!0}
!0 = !{i32 1, !"winx64-eh-unwindv2", i32 2}
