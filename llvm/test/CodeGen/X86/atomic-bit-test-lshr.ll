; RUN: llc < %s -mtriple=x86_64-- | FileCheck %s

; InstCombine's form of a single bit's test, (old >> X) read at bit 0 by a
; truncation to i1 or an AND with 1, or old itself truncated for bit 0, is
; lock bts/btr/btc returning the carry.

define i1 @bts_shift_test(ptr %p, i64 %n) nounwind {
; CHECK-LABEL: bts_shift_test:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    andl $63, %esi
; CHECK-NEXT:    lock btsq %rsi, (%rdi)
; CHECK-NEXT:    setb %al
; CHECK-NEXT:    retq
entry:
  %m = shl nuw i64 1, %n
  %old = atomicrmw or ptr %p, i64 %m seq_cst, align 8
  %s = lshr i64 %old, %n
  %r = trunc i64 %s to i1
  ret i1 %r
}

define i64 @btc_shift_test_and_one(ptr %p, i64 %n) nounwind {
; CHECK-LABEL: btc_shift_test_and_one:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    andl $63, %esi
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    lock btcq %rsi, (%rdi)
; CHECK-NEXT:    setb %al
; CHECK-NEXT:    retq
entry:
  %m = shl nuw i64 1, %n
  %old = atomicrmw xor ptr %p, i64 %m seq_cst, align 8
  %s = lshr i64 %old, %n
  %r = and i64 %s, 1
  ret i64 %r
}

define i1 @btr_shift_test_through_phi(ptr %p, i64 %n, i1 %c) nounwind {
; CHECK-LABEL: btr_shift_test_through_phi:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB2_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    andl $63, %esi
; CHECK-NEXT:    lock btrq %rsi, (%rdi)
; CHECK-NEXT:    setb %al
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB2_2: # %f
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    retq
entry:
  %m = shl nuw i64 1, %n
  br i1 %c, label %t, label %f
t:
  %mp = phi i64 [ %m, %entry ]
  %np = phi i64 [ %n, %entry ]
  %not = xor i64 %mp, -1
  %old = atomicrmw and ptr %p, i64 %not acq_rel, align 8
  %s = lshr i64 %old, %np
  %r = trunc i64 %s to i1
  ret i1 %r
f:
  ret i1 false
}

