# RUN: llc -mtriple=x86_64-unknown-windows-itanium \
# RUN:   -start-before=x86-windows-import-fusion %s -o - | FileCheck %s

# An outlined function does not say which registers its callers read once it
# returns, so no load in it is described to the linker.

--- |
  @ext = external global i32
  define i32 @access() { ret i32 0 }
  define i32 @outlined() { ret i32 0 }
...
---
# CHECK-LABEL: access:
# CHECK:         .linkfusedread
name:            access
tracksRegLiveness: true
body:             |
  bb.0:
    renamable $rax = MOV64rm $rip, 1, $noreg, target-flags(x86-dllimport) @ext, $noreg :: (load (s64) from got)
    renamable $eax = MOV32rm killed renamable $rax, 1, $noreg, 0, $noreg :: (dereferenceable load (s32) from @ext)
    RET64 $eax
...
---
# CHECK-LABEL: outlined:
# CHECK-NOT:     .link
# CHECK:         retq
name:            outlined
tracksRegLiveness: true
isOutlined:      true
body:             |
  bb.0:
    renamable $rax = MOV64rm $rip, 1, $noreg, target-flags(x86-dllimport) @ext, $noreg :: (load (s64) from got)
    renamable $eax = MOV32rm killed renamable $rax, 1, $noreg, 0, $noreg :: (dereferenceable load (s32) from @ext)
    RET64 $eax
...
