; Save and restore points may lie in a loop where they alternate on every
; path, each block that needs the frame between them.

@g = internal global i32 0

declare void @slow(i32)

; Only the cold call needs the frame, which is set up and torn down around it
; on each iteration that takes it.
define void @loop_cold() {
; ELF-LABEL: loop_cold:
; ELF:       # %bb.0: # %entry
; ELF-NEXT:    .p2align 4
; ELF-NEXT:  .LBB0_1: # %loop
; ELF-NEXT:    # =>This Inner Loop Header: Depth=1
; ELF-NEXT:    movl g(%rip), %edi
; ELF-NEXT:    testl %edi, %edi
; ELF-NEXT:    js .LBB0_2
; ELF-NEXT:  # %bb.3: # %latch
; ELF-NEXT:    # in Loop: Header=BB0_1 Depth=1
; ELF-NEXT:    cmpl $0, g(%rip)
; ELF-NEXT:    jne .LBB0_1
; ELF-NEXT:    jmp .LBB0_4
; ELF-NEXT:  .LBB0_2: # %cold
; ELF-NEXT:    # in Loop: Header=BB0_1 Depth=1
; ELF-NEXT:    pushq %rax
; ELF-NEXT:    .cfi_def_cfa_offset 16
; ELF-NEXT:    callq slow@PLT
; ELF-NEXT:    addq $8, %rsp
; ELF-NEXT:    .cfi_def_cfa_offset 8
; ELF-NEXT:    cmpl $0, g(%rip)
; ELF-NEXT:    jne .LBB0_1
; ELF-NEXT:  .LBB0_4: # %exit
; ELF-NEXT:    retq
entry:
  br label %loop

loop:
  %v = load volatile i32, ptr @g
  %neg = icmp slt i32 %v, 0
  br i1 %neg, label %cold, label %latch, !prof !0

cold:
  call void @slow(i32 %v)
  br label %latch

latch:
  %w = load volatile i32, ptr @g
  %done = icmp eq i32 %w, 0
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; The call's block would be the prologue's and epilogue's, but the loop then
; reaches the block that clobbers callee-saved registers after the epilogue
; and before the prologue: the frame spans the loop.
define void @loop_after_restore() {
; ELF-LABEL: loop_after_restore:
; ELF:       # %bb.0: # %entry
; ELF-NEXT:    pushq %rbx
; ELF-NEXT:    .cfi_def_cfa_offset 16
; ELF-NEXT:    .cfi_offset %rbx, -16
; ELF-NEXT:    .p2align 4
; ELF-NEXT:  .LBB1_1: # %loop
; ELF-NEXT:    # =>This Inner Loop Header: Depth=1
; ELF-NEXT:    xorl %edi, %edi
; ELF-NEXT:    callq slow@PLT
; ELF-NEXT:    cmpl $0, g(%rip)
; ELF-NEXT:    je .LBB1_3
; ELF-NEXT:  # %bb.2: # %clobber
; ELF-NEXT:    # in Loop: Header=BB1_1 Depth=1
; ELF-NEXT:    #APP
; ELF-NEXT:    #NO_APP
; ELF-NEXT:    jmp .LBB1_1
; ELF-NEXT:  .LBB1_3: # %exit
; ELF-NEXT:    popq %rbx
; ELF-NEXT:    .cfi_def_cfa_offset 8
; ELF-NEXT:    retq
entry:
  br label %loop

loop:
  call void @slow(i32 0)
  %v = load volatile i32, ptr @g
  %done = icmp eq i32 %v, 0
  br i1 %done, label %exit, label %clobber

clobber:
  call void asm sideeffect "", "~{rbx}"()
  br label %loop

exit:
  ret void
}

; The loop is cold, but the call's block, where the frame would alternate,
; runs on each of its iterations: the frame lies outside the loop.
