# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=x86_64-linux -run-pass=x86-avoid-sfb -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64-linux -passes=x86-avoid-sfb -verify-machineinstrs -o - %s | FileCheck %s
# Unordered atomic MMOs still require a single access; do not split them.
--- |
  define void @atomic_load(ptr noalias %src, ptr noalias %dst) { ret void }
  define void @atomic_store(ptr noalias %src, ptr noalias %dst) { ret void }
...
---
name: atomic_load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi, $rsi
    ; CHECK-LABEL: name: atomic_load
    ; CHECK: liveins: $rdi, $rsi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rdi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rsi
    ; CHECK-NEXT: MOV64mi32 [[COPY]], 1, $noreg, 0, $noreg, 0 :: (store (s64) into %ir.src)
    ; CHECK-NEXT: [[MOVUPSrm:%[0-9]+]]:vr128 = MOVUPSrm killed [[COPY]], 1, $noreg, 0, $noreg :: (load unordered (s128) from %ir.src)
    ; CHECK-NEXT: MOVUPSmr killed [[COPY1]], 1, $noreg, 0, $noreg, killed [[MOVUPSrm]] :: (store (s128) into %ir.dst)
    ; CHECK-NEXT: RET 0
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mi32 %0, 1, $noreg, 0, $noreg, 0 :: (store (s64) into %ir.src)
    %2:vr128 = MOVUPSrm killed %0, 1, $noreg, 0, $noreg :: (load unordered (s128) from %ir.src)
    MOVUPSmr killed %1, 1, $noreg, 0, $noreg, killed %2 :: (store (s128) into %ir.dst)
    RET 0
...
---
name: atomic_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi, $rsi
    ; CHECK-LABEL: name: atomic_store
    ; CHECK: liveins: $rdi, $rsi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rdi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rsi
    ; CHECK-NEXT: MOV64mi32 [[COPY]], 1, $noreg, 0, $noreg, 0 :: (store (s64) into %ir.src)
    ; CHECK-NEXT: [[MOVUPSrm:%[0-9]+]]:vr128 = MOVUPSrm killed [[COPY]], 1, $noreg, 0, $noreg :: (load (s128) from %ir.src)
    ; CHECK-NEXT: MOVUPSmr killed [[COPY1]], 1, $noreg, 0, $noreg, killed [[MOVUPSrm]] :: (store unordered (s128) into %ir.dst)
    ; CHECK-NEXT: RET 0
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mi32 %0, 1, $noreg, 0, $noreg, 0 :: (store (s64) into %ir.src)
    %2:vr128 = MOVUPSrm killed %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.src)
    MOVUPSmr killed %1, 1, $noreg, 0, $noreg, killed %2 :: (store unordered (s128) into %ir.dst)
    RET 0
...
