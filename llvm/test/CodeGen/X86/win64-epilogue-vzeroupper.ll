; Windows' unwinder takes an address for an epilogue's only where the stack
; release and the pops run straight into the return or the tail jump, and
; version 2 unwind info, required here, describes no other epilogue: the
; vzeroupper ahead of a return goes ahead of the epilogue.

declare ptr @g()
declare void @h(ptr)
declare void @use(ptr)

define void @ret(ptr %p) {
; CHECK-LABEL: ret:
; CHECK:       # %bb.0:
; CHECK-NEXT:    .seh_unwindversion 2
; CHECK-NEXT:    pushq %rsi
; CHECK-NEXT:    .seh_pushreg %rsi
; CHECK-NEXT:    subq $32, %rsp
; CHECK-NEXT:    .seh_stackalloc 32
; CHECK-NEXT:    .seh_endprologue
; CHECK-NEXT:    movq %rcx, %rsi
; CHECK-NEXT:    callq g
; CHECK-NEXT:    vxorps %xmm0, %xmm0, %xmm0
; CHECK-NEXT:    vmovaps %ymm0, (%rax)
; CHECK-NEXT:    movq %rax, (%rsi)
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    .seh_startepilogue
; CHECK-NEXT:    addq $32, %rsp
; CHECK-NEXT:    .seh_unwindv2start
; CHECK-NEXT:    popq %rsi
; CHECK-NEXT:    .seh_endepilogue
; CHECK-NEXT:    retq
; CHECK-NEXT:    .seh_endproc
  %a = call ptr @g()
  store <8 x float> zeroinitializer, ptr %a
  store ptr %a, ptr %p
  ret void
}

