; RUN: llc -mtriple=x86_64-unknown-windows-itanium < %s | FileCheck %s --check-prefix=WIN
; RUN: llc -mtriple=x86_64-linux-gnu < %s | FileCheck %s --check-prefix=ELF
; RUN: llc -mtriple=x86_64-unknown-windows-itanium -filetype=obj < %s \
; RUN:   | llvm-readobj --unwind - | FileCheck %s --check-prefix=UNWIND

; A load through a pointer of unknown origin reaches the function's frame only
; where an address in the frame was formed. With no such address, a call on a
; cold path is the only code that needs the frame, which is set up there.

; The cold part's frame is its unwind range, the jump back to the hot part
; its epilogue's last instruction.
; UNWIND:      StartAddress: deref2.cold (0x0)
; UNWIND-NEXT: EndAddress: deref2.cold +0x21 (0x4)
; UNWIND:      PrologSize: 4
; UNWIND:      UnwindCodes [
; UNWIND-NEXT:   0x01: EPILOG atend=no, length=0x1
; UNWIND-NEXT:   0x05: EPILOG offset=0x5
; UNWIND-NEXT:   0x04: ALLOC_SMALL size=40
; UNWIND-NEXT: ]

declare void @slow(i32)
declare void @slow_i64(i64)
declare void @publish(ptr)
declare void @init()

define i32 @deref2(ptr %pp, i32 %n) {
; WIN-LABEL: deref2:
; WIN:       # %bb.0: # %entry
; WIN-NEXT:    cmpl $42, %edx
; WIN-NEXT:    je deref2.cold
; WIN-NEXT:  .LBB0_1: # %join
; WIN-NEXT:    movq (%rcx), %rax
; WIN-NEXT:    movl (%rax), %eax
; WIN-NEXT:    retq
; WIN-NEXT:  .LBB_END0_1:
;
; ELF-LABEL: deref2:
; ELF:       # %bb.0: # %entry
; ELF-NEXT:    cmpl $42, %esi
; ELF-NEXT:    je .LBB0_1
; ELF-NEXT:  .LBB0_2: # %join
; ELF-NEXT:    movq (%rdi), %rax
; ELF-NEXT:    movl (%rax), %eax
; ELF-NEXT:    retq
; ELF-NEXT:  .LBB0_1: # %cold
; ELF-NEXT:    pushq %rax
; ELF-NEXT:    .cfi_def_cfa_offset 16
; ELF-NEXT:    movq %rdi, (%rsp) # 8-byte Spill
; ELF-NEXT:    movl $42, %edi
; ELF-NEXT:    callq slow@PLT
; ELF-NEXT:    movq (%rsp), %rdi # 8-byte Reload
; ELF-NEXT:    addq $8, %rsp
; ELF-NEXT:    .cfi_def_cfa_offset 8
; ELF-NEXT:    jmp .LBB0_2
entry:
  %c = icmp eq i32 %n, 42
  br i1 %c, label %cold, label %join, !prof !0

cold:
  call void @slow(i32 42)
  br label %join

join:
  %p = load ptr, ptr %pp
  %v = load i32, ptr %p
  ret i32 %v
}

; An argument passed in the caller's frame is no address in this one.
define i32 @deref2_stack_arg(ptr %pp, i32 %n, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6, i64 %a7, i64 %a8) {
; WIN-LABEL: deref2_stack_arg:
; WIN:       # %bb.0: # %entry
; WIN-NEXT:    cmpl $42, %edx
; WIN-NEXT:    je deref2_stack_arg.cold
; WIN-NEXT:  .LBB1_1: # %join
; WIN-NEXT:    movq (%rcx), %rax
; WIN-NEXT:    movl (%rax), %eax
; WIN-NEXT:    retq
; WIN-NEXT:  .LBB_END1_1:
;
; ELF-LABEL: deref2_stack_arg:
; ELF:       # %bb.0: # %entry
; ELF-NEXT:    cmpl $42, %esi
; ELF-NEXT:    je .LBB1_1
; ELF-NEXT:  .LBB1_2: # %join
; ELF-NEXT:    movq (%rdi), %rax
; ELF-NEXT:    movl (%rax), %eax
; ELF-NEXT:    retq
; ELF-NEXT:  .LBB1_1: # %cold
; ELF-NEXT:    pushq %rax
; ELF-NEXT:    .cfi_def_cfa_offset 16
; ELF-NEXT:    movq {{[0-9]+}}(%rsp), %rax
; ELF-NEXT:    movq %rdi, (%rsp) # 8-byte Spill
; ELF-NEXT:    movq %rax, %rdi
; ELF-NEXT:    callq slow_i64@PLT
; ELF-NEXT:    movq (%rsp), %rdi # 8-byte Reload
; ELF-NEXT:    addq $8, %rsp
; ELF-NEXT:    .cfi_def_cfa_offset 8
; ELF-NEXT:    jmp .LBB1_2
entry:
  %c = icmp eq i32 %n, 42
  br i1 %c, label %cold, label %join, !prof !0

cold:
  call void @slow_i64(i64 %a8)
  br label %join

join:
  %p = load ptr, ptr %pp
  %v = load i32, ptr %p
  ret i32 %v
}

; The cold path publishes a local's address, which the join may load through:
; the frame spans the join.
define i32 @escaped(ptr %pp, i32 %n) {
; WIN-LABEL: escaped:
; WIN:       # %bb.0: # %entry
; WIN-NEXT:    .seh_unwindversion 2
; WIN-NEXT:    subq $56, %rsp
; WIN-NEXT:    .seh_stackalloc 56
; WIN-NEXT:    .seh_endprologue
; WIN-NEXT:    cmpl $42, %edx
; WIN-NEXT:    je escaped.cold
; WIN-NEXT:  .LBB2_1: # %join
; WIN-NEXT:    movq (%rcx), %rax
; WIN-NEXT:    movl (%rax), %eax
; WIN-NEXT:    .seh_startepilogue
; WIN-NEXT:    addq $56, %rsp
; WIN-NEXT:    .seh_unwindv2start
; WIN-NEXT:    .seh_endepilogue
; WIN-NEXT:    retq
; WIN-NEXT:  .LBB_END2_1:
; WIN-NEXT:    .seh_endproc
;
; ELF-LABEL: escaped:
; ELF:       # %bb.0: # %entry
; ELF-NEXT:    subq $24, %rsp
; ELF-NEXT:    .cfi_def_cfa_offset 32
; ELF-NEXT:    cmpl $42, %esi
; ELF-NEXT:    je .LBB2_1
; ELF-NEXT:  .LBB2_2: # %join
; ELF-NEXT:    movq (%rdi), %rax
; ELF-NEXT:    movl (%rax), %eax
; ELF-NEXT:    addq $24, %rsp
; ELF-NEXT:    .cfi_def_cfa_offset 8
; ELF-NEXT:    retq
; ELF-NEXT:  .LBB2_1: # %cold
; ELF-NEXT:    .cfi_def_cfa_offset 32
; ELF-NEXT:    leaq {{[0-9]+}}(%rsp), %rax
; ELF-NEXT:    movq %rdi, {{[-0-9]+}}(%r{{[sb]}}p) # 8-byte Spill
; ELF-NEXT:    movq %rax, %rdi
; ELF-NEXT:    callq publish@PLT
; ELF-NEXT:    movq {{[-0-9]+}}(%r{{[sb]}}p), %rdi # 8-byte Reload
; ELF-NEXT:    jmp .LBB2_2
entry:
  %a = alloca i32
  %c = icmp eq i32 %n, 42
  br i1 %c, label %cold, label %join, !prof !0

cold:
  call void @publish(ptr %a)
  br label %join

join:
  %p = load ptr, ptr %pp
  %v = load i32, ptr %p
  ret i32 %v
}

; A guarded thread-local access: the block after the initializer's call loads
; through a pointer derived from the thread pointer.
@desc = external constant { ptr, i32, i32 }

define i32 @guarded_tls() {
; WIN-LABEL: guarded_tls:
; WIN:       # %bb.0: # %entry
; WIN-NEXT:    movq __imp_desc(%rip), %rdx
; WIN-NEXT:  .Ltmp0:
; WIN-NEXT:    .reloc .Ltmp0, IMAGE_REL_LLVM_FUSED_ACCESS, __imp_desc
; WIN-NEXT:    movq (%rdx), %rax
; WIN-NEXT:    movl (%rax), %eax
; WIN-NEXT:    movq %gs:88, %rcx
; WIN-NEXT:    movq (%rcx,%rax,8), %rax
; WIN-NEXT:  .Ltmp1:
; WIN-NEXT:    .reloc .Ltmp1, IMAGE_REL_LLVM_FUSED_ACCESS, __imp_desc
; WIN-NEXT:    movl 12(%rdx), %ecx
; WIN-NEXT:    cmpb $0, (%rax,%rcx)
; WIN-NEXT:    je guarded_tls.cold
; WIN-NEXT:  .LBB3_1: # %join
; WIN-NEXT:    movl 8(%rdx), %ecx
; WIN-NEXT:    movl (%rax,%rcx), %eax
; WIN-NEXT:    retq
; WIN-NEXT:  .LBB_END3_1:
;
; ELF-LABEL: guarded_tls:
; ELF:       # %bb.0: # %entry
; ELF-NEXT:    movq desc@GOTPCREL(%rip), %rax
; ELF-NEXT:    movq (%rax), %rcx
; ELF-NEXT:    movl (%rcx), %ecx
; ELF-NEXT:    movq %fs:(,%rcx,8), %rcx
; ELF-NEXT:    movl 12(%rax), %edx
; ELF-NEXT:    cmpb $0, (%rcx,%rdx)
; ELF-NEXT:    je .LBB3_1
; ELF-NEXT:  .LBB3_2: # %join
; ELF-NEXT:    movl 8(%rax), %eax
; ELF-NEXT:    movl (%rcx,%rax), %eax
; ELF-NEXT:    retq
; ELF-NEXT:  .LBB3_1: # %cold
; ELF-NEXT:    pushq %rax
; ELF-NEXT:    .cfi_def_cfa_offset 16
; ELF-NEXT:    movq %rcx, (%rsp) # 8-byte Spill
; ELF-NEXT:    callq init@PLT
; ELF-NEXT:    movq (%rsp), %rcx # 8-byte Reload
; ELF-NEXT:    movq desc@GOTPCREL(%rip), %rax
; ELF-NEXT:    addq $8, %rsp
; ELF-NEXT:    .cfi_def_cfa_offset 8
; ELF-NEXT:    jmp .LBB3_2
entry:
  %0 = load ptr, ptr @desc, !invariant.load !1
  %1 = load i32, ptr %0, !invariant.load !1
  %2 = call ptr @llvm.thread.pointer.p0()
  %3 = zext i32 %1 to i64
  %4 = getelementptr inbounds [8 x i8], ptr %2, i64 %3
  %5 = load ptr, ptr %4
  %6 = load i32, ptr getelementptr inbounds (i8, ptr @desc, i64 12), !invariant.load !1
  %7 = zext i32 %6 to i64
  %8 = getelementptr inbounds i8, ptr %5, i64 %7
  %9 = load i8, ptr %8
  %10 = icmp eq i8 %9, 0
  br i1 %10, label %cold, label %join, !prof !0

cold:
  call void @init()
  br label %join

join:
  %11 = load i32, ptr getelementptr inbounds (i8, ptr @desc, i64 8), !invariant.load !1
  %12 = zext i32 %11 to i64
  %13 = getelementptr inbounds i8, ptr %5, i64 %12
  %14 = load i32, ptr %13
  ret i32 %14
}

declare ptr @llvm.thread.pointer.p0()

!0 = !{!"branch_weights", i32 1, i32 2000}
!1 = !{}
