  define void @low_pressure(ptr %src, ptr %dst) { ret void }
  define void @successor_pressure(ptr %src, ptr %dst) { ret void }
  define void @phi_pressure(ptr %src, ptr %dst) { ret void }
  define void @two_copies(ptr %src, ptr %dst) { ret void }
