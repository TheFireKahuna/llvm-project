  define void @separated_copy(ptr %src, ptr %dst) { ret void }
...
---
name: low_pressure
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi, $rsi
    ; CHECK-LABEL: name: low_pressure
    ; CHECK: liveins: $rdi, $rsi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY killed $rdi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY killed $rsi
    ; CHECK-NEXT: MOV64mi32 [[COPY]], 1, $noreg, 0, $noreg, 0 :: (store (s64) into %ir.src)
    ; CHECK-NEXT: [[MOV64rm:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 0, $noreg :: (load (s64) from %ir.src, align 16)
    ; CHECK-NEXT: [[MOV64rm1:%[0-9]+]]:gr64 = MOV64rm killed [[COPY]], 1, $noreg, 8, $noreg :: (load (s64) from %ir.src + 8, basealign 16)
    ; CHECK-NEXT: MOV64mr [[COPY1]], 1, $noreg, 0, $noreg, killed [[MOV64rm]] :: (store (s64) into %ir.dst, align 16)
    ; CHECK-NEXT: MOV64mr killed [[COPY1]], 1, $noreg, 8, $noreg, killed [[MOV64rm1]] :: (store (s64) into %ir.dst + 8, basealign 16)
    ; CHECK-NEXT: RET 0
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mi32 %0, 1, $noreg, 0, $noreg, 0 :: (store (s64) into %ir.src)
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.src)
    MOVUPSmr %1, 1, $noreg, 0, $noreg, %2 :: (store (s128) into %ir.dst)
    RET 0
...
