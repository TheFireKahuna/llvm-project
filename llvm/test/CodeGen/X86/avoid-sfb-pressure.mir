  ; SYSV-NEXT:   [[MOV64rm3:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 0, $noreg :: (load (s64) from %ir.src, align 16)
  ; SYSV-NEXT:   [[MOV64rm4:%[0-9]+]]:gr64 = MOV64rm killed [[COPY]], 1, $noreg, 8, $noreg :: (load (s64) from %ir.src + 8, basealign 16)
  ; SYSV-NEXT:   MOV64mr [[COPY1]], 1, $noreg, 0, $noreg, killed [[MOV64rm3]] :: (store (s64) into %ir.dst, align 16)
  ; SYSV-NEXT:   MOV64mr killed [[COPY1]], 1, $noreg, 8, $noreg, killed [[MOV64rm4]] :: (store (s64) into %ir.dst + 8, basealign 16)
  ; SYSV-NEXT:   JMP_1 %bb.1
