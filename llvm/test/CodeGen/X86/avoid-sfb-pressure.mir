  ; SYSV-NEXT:   [[ADD64rr:%[0-9]+]]:gr64 = ADD64rr killed [[MOV64rm]], killed [[MOV64rm1]], implicit-def dead $eflags
  ; SYSV-NEXT:   [[ADD64rr1:%[0-9]+]]:gr64 = ADD64rr killed [[ADD64rr]], killed [[MOV64rm2]], implicit-def dead $eflags
  ; SYSV-NEXT:   $rax = COPY killed [[ADD64rr1]]
  ; SYSV-NEXT:   RET 0, implicit killed $rax
  ;
  ; WIN-LABEL: name: abi_pressure
  ; WIN: bb.0:
  ; WIN-NEXT:   successors: %bb.1(0x80000000)
  ; WIN-NEXT:   liveins: $rdi, $rsi
  ; WIN-NEXT: {{  $}}
  ; WIN-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY killed $rdi
  ; WIN-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY killed $rsi
  ; WIN-NEXT:   [[MOV64rm:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 64, $noreg :: (load (s64) from %ir.src + 64)
  ; WIN-NEXT:   [[MOV64rm1:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 72, $noreg :: (load (s64) from %ir.src + 72)
  ; WIN-NEXT:   [[MOV64rm2:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 80, $noreg :: (load (s64) from %ir.src + 80)
  ; WIN-NEXT:   MOV64mi32 [[COPY]], 1, $noreg, 0, $noreg, 0 :: (store (s64) into %ir.src)
  ; WIN-NEXT:   [[MOV64rm3:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 0, $noreg :: (load (s64) from %ir.src, align 16)
  ; WIN-NEXT:   [[MOVQI2PQIrm:%[0-9]+]]:vr128 = MOVQI2PQIrm killed [[COPY]], 1, $noreg, 8, $noreg :: (load (s64) from %ir.src + 8, basealign 16)
