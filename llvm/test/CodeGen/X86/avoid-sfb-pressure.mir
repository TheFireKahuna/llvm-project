  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY killed $rsi
  ; CHECK-NEXT:   [[MOV64rm:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 88, $noreg :: (load (s64) from %ir.src + 88)
  ; CHECK-NEXT:   [[MOV64rm1:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 96, $noreg :: (load (s64) from %ir.src + 96)
  ; CHECK-NEXT:   [[MOV64rm2:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 104, $noreg :: (load (s64) from %ir.src + 104)
  ; CHECK-NEXT:   [[MOV64rm3:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 112, $noreg :: (load (s64) from %ir.src + 112)
  ; CHECK-NEXT:   [[MOV64rm4:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 120, $noreg :: (load (s64) from %ir.src + 120)
  ; CHECK-NEXT:   [[MOV64rm5:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 128, $noreg :: (load (s64) from %ir.src + 128)
  ; CHECK-NEXT:   MOV64mi32 [[COPY]], 1, $noreg, 0, $noreg, 0 :: (store (s64) into %ir.src)
  ; CHECK-NEXT:   [[MOVQI2PQIrm:%[0-9]+]]:vr128 = MOVQI2PQIrm [[COPY]], 1, $noreg, 0, $noreg :: (load (s64) from %ir.src, align 16)
  ; CHECK-NEXT:   [[MOVQI2PQIrm1:%[0-9]+]]:vr128 = MOVQI2PQIrm [[COPY]], 1, $noreg, 8, $noreg :: (load (s64) from %ir.src + 8, basealign 16)
  ; CHECK-NEXT:   MOVPQI2QImr [[COPY1]], 1, $noreg, 0, $noreg, killed [[MOVQI2PQIrm]] :: (store (s64) into %ir.dst, align 16)
  ; CHECK-NEXT:   MOVPQI2QImr killed [[COPY1]], 1, $noreg, 8, $noreg, killed [[MOVQI2PQIrm1]] :: (store (s64) into %ir.dst + 8, basealign 16)
  ; CHECK-NEXT:   TEST64rr killed [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit killed $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV64ri:%[0-9]+]]:gr64 = MOV64ri 9
  ; CHECK-NEXT:   [[MOV64ri1:%[0-9]+]]:gr64 = MOV64ri 10
  ; CHECK-NEXT:   [[MOV64ri2:%[0-9]+]]:gr64 = MOV64ri 11
  ; CHECK-NEXT:   [[MOV64ri3:%[0-9]+]]:gr64 = MOV64ri 12
  ; CHECK-NEXT:   [[MOV64ri4:%[0-9]+]]:gr64 = MOV64ri 13
  ; CHECK-NEXT:   [[MOV64ri5:%[0-9]+]]:gr64 = MOV64ri 14
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr64 = PHI [[MOV64rm]], %bb.0, [[MOV64ri]], %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gr64 = PHI [[MOV64rm1]], %bb.0, [[MOV64ri1]], %bb.1
  ; CHECK-NEXT:   [[PHI2:%[0-9]+]]:gr64 = PHI [[MOV64rm2]], %bb.0, [[MOV64ri2]], %bb.1
  ; CHECK-NEXT:   [[PHI3:%[0-9]+]]:gr64 = PHI [[MOV64rm3]], %bb.0, [[MOV64ri3]], %bb.1
  ; CHECK-NEXT:   [[PHI4:%[0-9]+]]:gr64 = PHI [[MOV64rm4]], %bb.0, [[MOV64ri4]], %bb.1
  ; CHECK-NEXT:   [[PHI5:%[0-9]+]]:gr64 = PHI [[MOV64rm5]], %bb.0, [[MOV64ri5]], %bb.1
  ; CHECK-NEXT:   [[ADD64rr:%[0-9]+]]:gr64 = ADD64rr killed [[PHI]], killed [[PHI1]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD64rr1:%[0-9]+]]:gr64 = ADD64rr killed [[ADD64rr]], killed [[PHI2]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD64rr2:%[0-9]+]]:gr64 = ADD64rr killed [[ADD64rr1]], killed [[PHI3]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD64rr3:%[0-9]+]]:gr64 = ADD64rr killed [[ADD64rr2]], killed [[PHI4]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD64rr4:%[0-9]+]]:gr64 = ADD64rr killed [[ADD64rr3]], killed [[PHI5]], implicit-def dead $eflags
  ; CHECK-NEXT:   $rax = COPY killed [[ADD64rr4]]
  ; CHECK-NEXT:   RET 0, implicit killed $rax
  bb.0:
    liveins: $rdi, $rsi
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    %3:gr64 = MOV64rm %0, 1, $noreg, 88, $noreg :: (load (s64) from %ir.src + 88)
    %4:gr64 = MOV64rm %0, 1, $noreg, 96, $noreg :: (load (s64) from %ir.src + 96)
    %5:gr64 = MOV64rm %0, 1, $noreg, 104, $noreg :: (load (s64) from %ir.src + 104)
    %6:gr64 = MOV64rm %0, 1, $noreg, 112, $noreg :: (load (s64) from %ir.src + 112)
    %7:gr64 = MOV64rm %0, 1, $noreg, 120, $noreg :: (load (s64) from %ir.src + 120)
    %8:gr64 = MOV64rm %0, 1, $noreg, 128, $noreg :: (load (s64) from %ir.src + 128)
    MOV64mi32 %0, 1, $noreg, 0, $noreg, 0 :: (store (s64) into %ir.src)
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.src)
    MOVUPSmr %1, 1, $noreg, 0, $noreg, %2 :: (store (s128) into %ir.dst)
    TEST64rr %0, %0, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    %9:gr64 = MOV64ri 9
    %10:gr64 = MOV64ri 10
    %11:gr64 = MOV64ri 11
    %12:gr64 = MOV64ri 12
    %13:gr64 = MOV64ri 13
    %14:gr64 = MOV64ri 14
    JMP_1 %bb.2

  bb.2:
    %20:gr64 = PHI %3, %bb.0, %9, %bb.1
    %21:gr64 = PHI %4, %bb.0, %10, %bb.1
    %22:gr64 = PHI %5, %bb.0, %11, %bb.1
    %23:gr64 = PHI %6, %bb.0, %12, %bb.1
    %24:gr64 = PHI %7, %bb.0, %13, %bb.1
    %25:gr64 = PHI %8, %bb.0, %14, %bb.1
    %30:gr64 = ADD64rr %20, %21, implicit-def dead $eflags
    %31:gr64 = ADD64rr %30, %22, implicit-def dead $eflags
    %32:gr64 = ADD64rr %31, %23, implicit-def dead $eflags
    %33:gr64 = ADD64rr %32, %24, implicit-def dead $eflags
    %34:gr64 = ADD64rr %33, %25, implicit-def dead $eflags
    $rax = COPY %34
    RET 0, implicit $rax
...
