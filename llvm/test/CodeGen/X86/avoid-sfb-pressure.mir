    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.src)
    MOVUPSmr %1, 1, $noreg, 0, $noreg, %2 :: (store (s128) into %ir.dst)
    MOV64mi32 %1, 1, $noreg, 0, $noreg, 1 :: (store (s64) into %ir.dst)
    %3:vr128 = MOVUPSrm %1, 1, $noreg, 0, $noreg :: (load (s128) from %ir.dst)
    MOVUPSmr %0, 1, $noreg, 0, $noreg, %3 :: (store (s128) into %ir.src)
