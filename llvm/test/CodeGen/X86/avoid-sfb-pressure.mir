  ; WIN-NEXT:   MOVPQI2QImr killed [[COPY1]], 1, $noreg, 8, $noreg, killed [[MOVQI2PQIrm]] :: (store (s64) into %ir.dst + 8, basealign 16)
  ; WIN-NEXT:   JMP_1 %bb.1
  ; WIN-NEXT: {{  $}}
