; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=x86_64-unknown-linux-gnu < %s | FileCheck %s

; The bit-test and compare-arithmetic forms keep the atomicrmw's address space,
; here a gs-relative pointer.

define i1 @bts_gs(ptr addrspace(256) %p) {
; CHECK-LABEL: bts_gs:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lock btsq $4, %gs:(%rdi)
; CHECK-NEXT:    setb %al
; CHECK-NEXT:    retq
  %r = atomicrmw or ptr addrspace(256) %p, i64 16 seq_cst, align 8
  %m = and i64 %r, 16
  %c = icmp ne i64 %m, 0
  ret i1 %c
}
define i1 @sub_cc_gs(ptr addrspace(256) %p) {
; CHECK-LABEL: sub_cc_gs:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lock decq %gs:(%rdi)
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %r = atomicrmw sub ptr addrspace(256) %p, i64 1 seq_cst, align 8
  %c = icmp eq i64 %r, 1
  ret i1 %c
}
