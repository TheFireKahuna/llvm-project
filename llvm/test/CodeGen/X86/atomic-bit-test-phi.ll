; Two phis of the one shift amount name the same bit.
define i1 @bts_shift_amounts_through_phis(ptr %p, i64 %n, i1 %c) nounwind {
; CHECK-LABEL: bts_shift_amounts_through_phis:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB3_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    andl $63, %esi
; CHECK-NEXT:    lock btsq %rsi, (%rdi)
; CHECK-NEXT:    setb %al
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB3_2: # %f
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    retq
entry:
  br i1 %c, label %t, label %f
t:
  %n1 = phi i64 [ %n, %entry ]
  %n2 = phi i64 [ %n, %entry ]
  %m1 = shl nuw i64 1, %n1
  %m2 = shl nuw i64 1, %n2
  %old = atomicrmw or ptr %p, i64 %m1 seq_cst, align 8
  %b = and i64 %old, %m2
  %r = icmp ne i64 %b, 0
  ret i1 %r
f:
  ret i1 false
}

; A phi of two masks is not one bit.
define i1 @bts_two_masks(ptr %p, i64 %n, i64 %k, i1 %c) nounwind {
; CHECK-LABEL: bts_two_masks:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    movl %ecx, %eax
; CHECK-NEXT:    movq %rsi, %rcx
; CHECK-NEXT:    movl $1, %r8d
; CHECK-NEXT:    movl $1, %esi
; CHECK-NEXT:    # kill: def $cl killed $cl killed $rcx
; CHECK-NEXT:    shlq %cl, %rsi
; CHECK-NEXT:    testb $1, %al
; CHECK-NEXT:    jne .LBB4_2
; CHECK-NEXT:  # %bb.1: # %e
; CHECK-NEXT:    movl %edx, %ecx
; CHECK-NEXT:    shlq %cl, %r8
; CHECK-NEXT:    movq %r8, %rsi
; CHECK-NEXT:  .LBB4_2: # %t
; CHECK-NEXT:    movq (%rdi), %rax
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB4_3: # %atomicrmw.start
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    movq %rax, %rcx
; CHECK-NEXT:    orq %rsi, %rcx
; CHECK-NEXT:    lock cmpxchgq %rcx, (%rdi)
; CHECK-NEXT:    jne .LBB4_3
; CHECK-NEXT:  # %bb.4: # %atomicrmw.end
; CHECK-NEXT:    testq %rsi, %rax
; CHECK-NEXT:    setne %al
; CHECK-NEXT:    retq
entry:
  %m = shl nuw i64 1, %n
  br i1 %c, label %t, label %e
e:
  %m2 = shl nuw i64 1, %k
  br label %t
t:
  %mp = phi i64 [ %m, %entry ], [ %m2, %e ]
  %old = atomicrmw or ptr %p, i64 %mp seq_cst, align 8
  %b = and i64 %old, %mp
  %r = icmp ne i64 %b, 0
  ret i1 %r
}
