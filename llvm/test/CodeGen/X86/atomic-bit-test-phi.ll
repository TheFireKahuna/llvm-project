; RUN: llc < %s -mtriple=x86_64-- | FileCheck %s

; A single-bit operand, or the AND that tests the result, reached through a
; phi that merges one value is still that bit: lock bts/btr, not cmpxchg.

; The mask behind a phi, and the NOT of it.
define i1 @bts_shift_through_phi(ptr %p, i64 %n, i1 %c) nounwind {
; CHECK-LABEL: bts_shift_through_phi:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB0_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    andl $63, %esi
; CHECK-NEXT:    lock btsq %rsi, (%rdi)
; CHECK-NEXT:    setb %al
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB0_2: # %f
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    retq
entry:
  %m = shl nuw i64 1, %n
  br i1 %c, label %t, label %f
t:
  %mp = phi i64 [ %m, %entry ]
  %old = atomicrmw or ptr %p, i64 %mp seq_cst, align 8
  %b = and i64 %old, %mp
  %r = icmp ne i64 %b, 0
  ret i1 %r
f:
  ret i1 false
}

define i1 @btr_shift_through_phi(ptr %p, i64 %n, i1 %c) nounwind {
; CHECK-LABEL: btr_shift_through_phi:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB1_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    andl $63, %esi
; CHECK-NEXT:    lock btrq %rsi, (%rdi)
; CHECK-NEXT:    setb %al
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB1_2: # %f
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    retq
entry:
  %m = shl nuw i64 1, %n
  br i1 %c, label %t, label %f
t:
  %mp = phi i64 [ %m, %entry ]
  %not = xor i64 %mp, -1
  %old = atomicrmw and ptr %p, i64 %not acq_rel, align 8
  %b = and i64 %old, %mp
  %r = icmp ne i64 %b, 0
  ret i1 %r
f:
  ret i1 false
}

