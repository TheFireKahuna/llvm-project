; Narrow, unaligned blockers create too many simultaneously live fragments.
; Keep the vector copy when the proposed split exceeds the register budget.
define void @byte_tail(ptr %src, ptr %dst, i8 %value) {
; SSE-LABEL: byte_tail:
; SSE:       # %bb.0:
; SSE-NEXT:    movb %dl, 31(%rdi)
; SSE-NEXT:    movups (%rdi), %xmm0
; SSE-NEXT:    movups 16(%rdi), %xmm1
; SSE-NEXT:    movups %xmm1, 16(%rsi)
; SSE-NEXT:    movups %xmm0, (%rsi)
; SSE-NEXT:    retq
;
; AVX-LABEL: byte_tail:
; AVX:       # %bb.0:
; AVX-NEXT:    movb %dl, 31(%rdi)
; AVX-NEXT:    vmovups (%rdi), %ymm0
; AVX-NEXT:    vmovups %ymm0, (%rsi)
; AVX-NEXT:    vzeroupper
; AVX-NEXT:    retq
  %tail = getelementptr i8, ptr %src, i64 31
  store i8 %value, ptr %tail, align 1
  call void @llvm.memmove.p0.p0.i64(ptr %dst, ptr %src, i64 32, i1 false)
  ret void
}

