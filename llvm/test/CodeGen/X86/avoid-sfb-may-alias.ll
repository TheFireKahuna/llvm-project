; A blocker on only one predecessor must not change the copy on the other path.
define void @conditional_blocker(ptr %src, ptr %dst, i64 %value, i1 %cond) {
; SSE-LABEL: conditional_blocker:
; SSE:       # %bb.0: # %entry
; SSE-NEXT:    testb $1, %cl
; SSE-NEXT:    je .LBB7_2
; SSE-NEXT:  # %bb.1: # %update
; SSE-NEXT:    movq %rdx, (%rdi)
; SSE-NEXT:  .LBB7_2: # %copy
; SSE-NEXT:    movups (%rdi), %xmm0
; SSE-NEXT:    movups %xmm0, (%rsi)
; SSE-NEXT:    retq
;
; AVX-LABEL: conditional_blocker:
; AVX:       # %bb.0: # %entry
; AVX-NEXT:    testb $1, %cl
; AVX-NEXT:    je .LBB7_2
; AVX-NEXT:  # %bb.1: # %update
; AVX-NEXT:    movq %rdx, (%rdi)
; AVX-NEXT:  .LBB7_2: # %copy
; AVX-NEXT:    vmovups (%rdi), %xmm0
; AVX-NEXT:    vmovups %xmm0, (%rsi)
; AVX-NEXT:    retq
entry:
  br i1 %cond, label %update, label %copy
update:
  store i64 %value, ptr %src, align 8
  br label %copy
copy:
  call void @llvm.memmove.p0.p0.i64(ptr %dst, ptr %src, i64 16, i1 false)
  ret void
}

