; AVX-NEXT:    retq
  call void @llvm.memmove.p0.p0.i64(ptr align 1 %dst, ptr align 8 %src, i64 16, i1 false)
  ret void
}

; The ordered vector access must not be split even with disjoint parameters.
define void @volatile_load(ptr noalias %src, ptr noalias %dst, i64 %value) {
; SSE-LABEL: volatile_load:
; SSE:       # %bb.0:
; SSE-NEXT:    movq %rdx, (%rdi)
; SSE-NEXT:    movups (%rdi), %xmm0
; SSE-NEXT:    movups %xmm0, (%rsi)
; SSE-NEXT:    retq
;
; AVX-LABEL: volatile_load:
; AVX:       # %bb.0:
; AVX-NEXT:    movq %rdx, (%rdi)
; AVX-NEXT:    vmovups (%rdi), %xmm0
; AVX-NEXT:    vmovups %xmm0, (%rsi)
; AVX-NEXT:    retq
  store i64 %value, ptr %src, align 8
  %v = load volatile <2 x i64>, ptr %src, align 8
  store <2 x i64> %v, ptr %dst, align 8
  ret void
}

