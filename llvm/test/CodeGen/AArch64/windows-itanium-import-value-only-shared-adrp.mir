# RUN: llc -mtriple=aarch64-unknown-windows-itanium \
# RUN:   -start-before=aarch64-windows-import-fusion %s -o - | FileCheck %s

# One adrp of the import pointer's page that several ldrs of the pointer
# read, as where it was hoisted out of a loop, serves them as value-only loads
# together, each naming it, where every address they load is only read through,
# whatever the rest of the function does with the data's address; where one is
# not, none is described, since the linker makes the adrp give the copy's
# page.

--- |
  $tbl = comdat any
  @tbl = linkonce_odr constant [4 x i32] [i32 1, i32 2, i32 3, i32 4], comdat
  @sink = external global ptr
  ; The functions' IR takes the address, so that only what their code does
  ; with each register decides.
  define i32 @shared() {
    store ptr @tbl, ptr @sink
    ret i32 0
  }
  define i32 @escaped() {
    store ptr @tbl, ptr @sink
    ret i32 0
  }
...
---
# CHECK-LABEL: shared:
# CHECK:       .Lpage[[#N:]]:
# CHECK-NEXT:    adrp x8, __imp_tbl
# CHECK-NEXT:    .linkvalueonly .Lpage[[#N]]
# CHECK-NEXT:    ldr x9, [x8, :lo12:__imp_tbl]
# CHECK-NEXT:    .linkvalueonly .Lpage[[#N]]
# CHECK-NEXT:    ldr x10, [x8, :lo12:__imp_tbl]
name:            shared
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0
    $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @tbl
    renamable $x9 = LDRXui $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @tbl
    renamable $x10 = LDRXui killed $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @tbl
    renamable $w0 = LDRWui killed renamable $x9, 0 :: (dereferenceable load (s32) from @tbl)
    renamable $w1 = LDRWui killed renamable $x10, 1 :: (dereferenceable load (s32) from @tbl)
    $w0 = ADDWrs killed $w0, killed $w1, 0
    RET undef $lr, implicit $w0
...
---
# The read through the other register is described as one, its load staying.
# CHECK-LABEL: escaped:
# CHECK-NOT:     .linkvalueonly .Lpage
# CHECK:         .linkvalueonly{{$}}
# CHECK-NEXT:    .linkfusedaccess .Lfused{{[0-9]+}}, x9
# CHECK-NEXT:    ldr w0, [x9]
# CHECK-NOT:     .linkvalueonly
# CHECK:         ret
name:            escaped
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0, $x1
    $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @tbl
    renamable $x9 = LDRXui $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @tbl
    renamable $x10 = LDRXui killed $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @tbl
    renamable $w0 = LDRWui killed renamable $x9, 0 :: (dereferenceable load (s32) from @tbl)
    STRXui killed renamable $x10, killed renamable $x1, 0 :: (store (s64) into @sink)
    RET undef $lr, implicit $w0
...
