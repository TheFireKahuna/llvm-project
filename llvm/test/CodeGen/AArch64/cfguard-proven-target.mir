# RUN: llc -mtriple=aarch64-unknown-windows-itanium \
# RUN:   -run-pass=aarch64-expand-pseudo -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# The check before a call whose target was loaded from a table the CFGuard
# pass proved is dropped only if the target stayed in its register from the
# load to the call, and the load's address was not reloaded on the way.

--- |
  @table = internal constant [4 x ptr] zeroinitializer
  @__guard_check_icall_fptr = external global ptr
  declare void @__llvm_kcfi_check_0000000c()
  define void @in_register() { ret void }
  define void @copied() { ret void }
  define void @guard_check() { ret void }
  define void @target_reloaded() { ret void }
...
---
# CHECK-LABEL: name: in_register
# CHECK:       renamable $x15 = LDRXroX
# CHECK-NEXT:  BLR killed renamable $x15
name: in_register
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x9
    renamable $x8 = ANDXri killed renamable $x0, 4097
    renamable $x15 = LDRXroX killed renamable $x9, killed renamable $x8, 0, 1 :: (invariant "aarch64-proven-call-target" load (s64))
    BL @__llvm_kcfi_check_0000000c, csr_win_aarch64_cfguard_check, implicit-def dead $lr, implicit $sp, implicit $x15, implicit-def $sp
    BLR killed renamable $x15, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp
    RET_ReallyLR
...
---
# CHECK-LABEL: name: copied
# CHECK:       renamable $x2 = LDRXroX
# CHECK-NEXT:  BLR killed renamable $x2
name: copied
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x9
    renamable $x8 = ANDXri killed renamable $x0, 4097
    renamable $x2 = LDRXroX killed renamable $x9, killed renamable $x8, 0, 1 :: (invariant "aarch64-proven-call-target" load (s64))
    $x15 = COPY $x2
    BL @__llvm_kcfi_check_0000000c, csr_win_aarch64_cfguard_check, implicit-def dead $lr, implicit $sp, implicit killed $x15, implicit-def $sp
    BLR killed renamable $x2, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp
    RET_ReallyLR
...
---
# CHECK-LABEL: name: guard_check
# CHECK-NOT:   __guard_check_icall_fptr
# CHECK:       renamable $x15 = LDRXroX
# CHECK-NEXT:  BLR killed renamable $x15
name: guard_check
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x9
    renamable $x8 = ANDXri killed renamable $x0, 4097
    renamable $x10 = ADRP target-flags(aarch64-page) @__guard_check_icall_fptr
    renamable $x15 = LDRXroX killed renamable $x9, killed renamable $x8, 0, 1 :: (invariant "aarch64-proven-call-target" load (s64))
    renamable $x8 = LDRXui killed renamable $x10, target-flags(aarch64-pageoff, aarch64-nc) @__guard_check_icall_fptr :: (dereferenceable load (s64) from @__guard_check_icall_fptr)
    BLR killed renamable $x8, csr_win_aarch64_cfguard_check, implicit-def dead $lr, implicit $sp, implicit $x15, implicit-def $sp
    BLR killed renamable $x15, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp
    RET_ReallyLR
...
---
# CHECK-LABEL: name: target_reloaded
# CHECK:       BL @__llvm_kcfi_check_0000000c
name: target_reloaded
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: -16, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $x0, $x9
    renamable $x8 = ANDXri killed renamable $x0, 4097
    renamable $x15 = LDRXroX killed renamable $x9, killed renamable $x8, 0, 1 :: (invariant "aarch64-proven-call-target" load (s64))
    STRXui killed $x15, $sp, 1 :: (store (s64) into %stack.0)
    $x15 = LDRXui $sp, 1 :: (load (s64) from %stack.0)
    BL @__llvm_kcfi_check_0000000c, csr_win_aarch64_cfguard_check, implicit-def dead $lr, implicit $sp, implicit $x15, implicit-def $sp
    BLR killed renamable $x15, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp
    RET_ReallyLR
...
