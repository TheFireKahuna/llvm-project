; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=aarch64-pc-windows-msvc | FileCheck %s

; On Windows the thread pointer is the thread's TLS array, which the TEB in x18
; holds at offset 0x58: TPIDR_EL0 is reserved there.

declare ptr @llvm.thread.pointer()

define ptr @thread_pointer() {
; CHECK-LABEL: thread_pointer:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ldr x0, [x18, #88]
; CHECK-NEXT:    ret
  %1 = tail call ptr @llvm.thread.pointer()
  ret ptr %1
}

define i32 @thread_pointer2(i32 %i) {
; CHECK-LABEL: thread_pointer2:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    ldr x8, [x18, #88]
; CHECK-NEXT:    ldr w0, [x8, w0, sxtw #2]
; CHECK-NEXT:    ret
entry:
  %0 = tail call ptr @llvm.thread.pointer()
  %arrayidx = getelementptr inbounds i32, ptr %0, i32 %i
  %1 = load i32, ptr %arrayidx, align 4
  ret i32 %1
}
