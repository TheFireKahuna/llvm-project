# RUN: llc -mtriple=aarch64-unknown-windows-itanium \
# RUN:   -start-after=unpack-mi-bundles %s -o - | \
# RUN:   FileCheck %s --implicit-check-not=site_fact

# On Windows Itanium and NT-POSIX a load or store through the register of a
# fused read takes the page offset of what the pointer names where the linker
# drops the read, so it is an access only where the read writes its own base.

--- |
  @v = external dllimport global i32
  declare dllimport void @f()
  declare void @g()
  define void @merged() { ret void }
  define void @split() { ret void }
  define void @copied() { ret void }
  define void @other_base() { ret void }
  define void @kept() { ret void }
  define void @unoptimized() noinline optnone { ret void }
  @c = linkonce_odr constant [4 x i32] zeroinitializer
  define void @shared() { ret void }
  define ptr @shared_taken() { ret ptr @c }
  define ptr @joined() { ret ptr @c }
  define ptr @joined_loads() { ret ptr @c }
  define void @pad() { ret void }
  define void @pad_clobbered() { ret void }
...

# Loads of one pointer into one register, as tail merging leaves them, reach
# one site.
# CHECK-LABEL: merged:
# CHECK:         ldr x8, [x8, :fused_lo12:__imp_f]
# CHECK:         ldr x8, [x8, :fused_lo12:__imp_f]
# CHECK:         .reloc {{.*}}, IMAGE_REL_LLVM_FUSED_CALL, __imp_f
# CHECK-NEXT:    blr x8
---
name:            merged
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x0, $lr
    CBZX renamable $x0, %bb.2
  bb.1:
    successors: %bb.3
    liveins: $x0, $lr
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @f
    renamable $x8 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @f
    renamable $x0 = ADDXri killed renamable $x0, 1, 0
    B %bb.3
  bb.2:
    liveins: $x0, $lr
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @f
    renamable $x8 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @f
  bb.3:
    liveins: $x0, $x8, $lr
    BLR killed renamable $x8, implicit-def dead $lr, implicit $sp, implicit $x0
    RET undef $lr
...

# The linker binds a function's sites as one: a load in its cold part reaches
# an access as one in the access's section does.
# CHECK-LABEL: split:
# CHECK:         ldr x8, [x8, :fused_lo12:__imp_v]
# CHECK:         .reloc {{.*}}, IMAGE_REL_LLVM_PAGEOFFSET_12L_IF_LOCAL, __imp_v
# CHECK-NEXT:    ldr w0, [x8]
# CHECK-LABEL: split.cold:
# CHECK:         ldr x8, [x8, :fused_lo12:__imp_v]
---
name:            split
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x0, $lr
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @v
    renamable $x8 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @v
    CBZX killed renamable $x0, %bb.2
  bb.1:
    liveins: $x8, $lr
    renamable $w0 = LDRWui killed renamable $x8, 0
    RET undef $lr, implicit $w0
  bb.2 (bbsections Cold):
    successors: %bb.1
    liveins: $lr
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @v
    renamable $x8 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @v
    B %bb.1
...

# A copy that accesses alone read is no reader.
# CHECK-LABEL: copied:
# CHECK:         ldr x8, [x8, :fused_lo12:__imp_v]
# CHECK-NEXT:    mov x9, x8
# CHECK-NEXT:  [[SITE:.Ltmp[0-9]+]]:
# CHECK-NEXT:    .reloc [[SITE]], IMAGE_REL_LLVM_PAGEOFFSET_12L_IF_LOCAL, __imp_v
# CHECK-NEXT:    ldp w0, w1, [x9, #8]
---
name:            copied
tracksRegLiveness: true
body:             |
  bb.0:
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @v
    renamable $x8 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @v
    renamable $x9 = ORRXrs $xzr, killed renamable $x8, 0
    renamable $w0, renamable $w1 = LDPWi killed renamable $x9, 2
    RET undef $lr, implicit $w0, implicit $w1
...

# A test of the register needs no own base.
# CHECK-LABEL: other_base:
# CHECK:         ldr x9, [x9, :lo12:__imp_v]
# CHECK-NEXT:  [[SITE:.Ltmp[0-9]+]]:
# CHECK-NEXT:    .reloc [[SITE]], IMAGE_REL_LLVM_FUSED_TEST, __imp_v
# CHECK-NEXT:    cbz x9,
# CHECK-NEXT:  // %bb.1:
# CHECK-NEXT:    ldr w0, [x9, #4]
---
name:            other_base
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @v
    renamable $x9 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @v
    CBZX renamable $x9, %bb.2
  bb.1:
    liveins: $x9
    renamable $w0 = LDRWui killed renamable $x9, 1
  bb.2:
    RET undef $lr
...

# Any other reader leaves no fused read, as does -O0.
# CHECK-LABEL: kept:
# CHECK:         ldr x8, [x8, :lo12:__imp_v]
# CHECK-NEXT:    add x0, x8, #8
# CHECK-NEXT:    ldr w1, [x8, #4]
---
name:            kept
tracksRegLiveness: true
body:             |
  bb.0:
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @v
    renamable $x8 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @v
    renamable $x0 = ADDXri renamable $x8, 8, 0
    renamable $w1 = LDRWui renamable $x8, 1
    RET undef $lr, implicit $x0, implicit $w1, implicit $x8
...

# CHECK-LABEL: unoptimized:
# CHECK:         ldr x8, [x8, :lo12:__imp_v]
# CHECK-NEXT:    ldr w0, [x8, #4]
---
name:            unoptimized
tracksRegLiveness: true
body:             |
  bb.0:
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @v
    renamable $x8 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @v
    renamable $w0 = LDRWui killed renamable $x8, 1
    RET undef $lr, implicit $w0
...

# Adrps, loads of a constant's pointer and what reads them join by register
# into webs. A web is stated where its loads only read the constant's value
# and its adrps only give such loads their page, whatever other webs do.
# CHECK-LABEL: shared:
# CHECK:         .site_fact 7, 0
# CHECK-NEXT:    adrp x8, __imp_c
# CHECK-NEXT:    .site_fact 7, 0
# CHECK-NEXT:    ldr x9, [x8, :lo12:__imp_c]
# CHECK-NEXT:    .site_fact 7, 0
# CHECK-NEXT:    ldr x10, [x8, :lo12:__imp_c]
---
name:            shared
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @c
    renamable $x9 = LDRXui renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @c
    renamable $x10 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @c
    renamable $w9 = LDRWroX killed renamable $x9, killed renamable $x0, 0, 1
    renamable $w10 = LDRWui killed renamable $x10, 1
    RET undef $lr, implicit $w9, implicit $w10
...

# CHECK-LABEL: shared_taken:
# CHECK:         adrp x8, __imp_c
# CHECK-NEXT:    ldr x9, [x8, :lo12:__imp_c]
# CHECK-NEXT:    ldr x0, [x8, :lo12:__imp_c]
---
name:            shared_taken
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x1
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @c
    renamable $x9 = LDRXui renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @c
    renamable $x0 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @c
    renamable $w9 = LDRWroX killed renamable $x9, killed renamable $x1, 0, 1
    RET undef $lr, implicit $x0, implicit $w9
...

# Two adrps may reach one load, and one adrp two loads.
# CHECK-LABEL: joined:
# CHECK:         .site_fact 7, 0
# CHECK-NEXT:    adrp x8, __imp_c
# CHECK:         .site_fact 7, 0
# CHECK-NEXT:    adrp x8, __imp_c
# CHECK:         .site_fact 7, 0
# CHECK-NEXT:    ldr x9, [x8, :lo12:__imp_c]
# CHECK:         .site_fact 7, 0
# CHECK-NEXT:    ldr x10, [x8, :lo12:__imp_c]
---
name:            joined
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x0, $x1, $w2
    CBZW killed renamable $w2, %bb.2
  bb.1:
    successors: %bb.3, %bb.4
    liveins: $x0, $x1
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @c
    CBZX renamable $x1, %bb.4
    B %bb.3
  bb.2:
    successors: %bb.3
    liveins: $x0, $x1
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @c
  bb.3:
    liveins: $x0, $x8
    renamable $x9 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @c
    renamable $w0 = LDRWroX killed renamable $x9, killed renamable $x0, 0, 1 :: (load (s32))
    RET undef $lr, implicit $w0
  bb.4:
    liveins: $x8
    renamable $x10 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @c
    renamable $w0 = LDRWui killed renamable $x10, 1 :: (load (s32))
    RET undef $lr, implicit $w0
...

# Two loads may reach one read.
# CHECK-LABEL: joined_loads:
# CHECK:         .site_fact 7, 0
# CHECK-NEXT:    adrp x9, __imp_c
# CHECK-NEXT:    .site_fact 7, 0
# CHECK-NEXT:    ldr x9, [x9, :lo12:__imp_c]
# CHECK:         .site_fact 7, 0
# CHECK-NEXT:    adrp x9, __imp_c
# CHECK-NEXT:    .site_fact 7, 0
# CHECK-NEXT:    ldr x9, [x9, :lo12:__imp_c]
---
name:            joined_loads
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x0, $w1
    CBZW killed renamable $w1, %bb.2
  bb.1:
    successors: %bb.3
    liveins: $x0
    renamable $x9 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @c
    renamable $x9 = LDRXui killed renamable $x9, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @c
    B %bb.3
  bb.2:
    successors: %bb.3
    liveins: $x0
    renamable $x9 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @c
    renamable $x9 = LDRXui killed renamable $x9, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @c
  bb.3:
    liveins: $x0, $x9
    renamable $w0 = LDRWroX killed renamable $x9, killed renamable $x0, 0, 1 :: (load (s32))
    RET undef $lr, implicit $w0
...

# A landing pad takes a register as an exception leaves the block that
# enters it, at a call, so what the block writes after its calls does not
# reach the pad, and a register that a call clobbers holds nothing there.
# CHECK-LABEL: pad:
# CHECK:         ldr x19, [x19, :fused_lo12:__imp_f]
# CHECK:         .reloc {{.*}}, IMAGE_REL_LLVM_FUSED_CALL, __imp_f
# CHECK-NEXT:    blr x19
# CHECK:         mov x19, xzr
# CHECK:         .reloc {{.*}}, IMAGE_REL_LLVM_FUSED_CALL, __imp_f
# CHECK-NEXT:    blr x19
---
name:            pad
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $lr
    renamable $x19 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @f
    renamable $x19 = LDRXui killed renamable $x19, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @f
    EH_LABEL <mcsymbol .Ltmp0>
    BLR renamable $x19, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp
    EH_LABEL <mcsymbol .Ltmp1>
    $x19 = ORRXrs $xzr, $xzr, 0
  bb.1:
    RET undef $lr
  bb.2 (landing-pad):
    liveins: $x19
    BLR killed renamable $x19, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp
    RET undef $lr
...

# CHECK-LABEL: pad_clobbered:
# CHECK:         ldr x8, [x8, :lo12:__imp_f]
# CHECK-NOT:     .reloc
# CHECK:         blr x8
---
name:            pad_clobbered
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $lr
    renamable $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @f
    renamable $x8 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @f
    EH_LABEL <mcsymbol .Ltmp2>
    BL @g, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp
    EH_LABEL <mcsymbol .Ltmp3>
  bb.1:
    RET undef $lr
  bb.2 (landing-pad):
    liveins: $x8
    BLR killed renamable $x8, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp
    RET undef $lr
...
