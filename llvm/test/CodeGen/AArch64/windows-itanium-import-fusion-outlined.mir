# RUN: llc -mtriple=aarch64-unknown-windows-itanium \
# RUN:   -start-before=aarch64-windows-import-fusion %s -o - | FileCheck %s

# An outlined function does not say which registers its callers read once it
# returns, so no load in it is described to the linker.

--- |
  @ext = external global i32
  define i32 @access() { ret i32 0 }
  define i32 @outlined() { ret i32 0 }
...
---
# CHECK-LABEL: access:
# CHECK:         .linkfusedread
name:            access
tracksRegLiveness: true
body:             |
  bb.0:
    $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @ext
    renamable $x8 = LDRXui killed $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @ext
    renamable $w0 = LDRWui killed renamable $x8, 0 :: (dereferenceable load (s32) from @ext)
    RET undef $lr, implicit $w0
...
---
# CHECK-LABEL: outlined:
# CHECK-NOT:     .link
# CHECK:         ret
name:            outlined
tracksRegLiveness: true
isOutlined:      true
body:             |
  bb.0:
    $x8 = ADRP target-flags(aarch64-page, aarch64-got, aarch64-dllimport) @ext
    renamable $x8 = LDRXui killed $x8, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc, aarch64-dllimport) @ext
    renamable $w0 = LDRWui killed renamable $x8, 0 :: (dereferenceable load (s32) from @ext)
    RET undef $lr, implicit $w0
...
