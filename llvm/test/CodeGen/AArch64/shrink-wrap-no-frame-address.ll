; The cold path publishes a local's address, which the join may load through:
; the frame spans the join.
define i32 @escaped(ptr %pp, i32 %n) {
; ELF-LABEL: escaped:
; ELF:       // %bb.0: // %entry
; ELF-NEXT:    sub sp, sp, #32
; ELF-NEXT:    stp x30, x19, [sp, #16] // 16-byte Folded Spill
; ELF-NEXT:    .cfi_def_cfa_offset 32
; ELF-NEXT:    .cfi_offset w19, -8
; ELF-NEXT:    .cfi_offset w30, -16
; ELF-NEXT:    cmp w1, #42
; ELF-NEXT:    b.eq .LBB2_2
; ELF-NEXT:  .LBB2_1: // %join
; ELF-NEXT:    ldr x8, [x0]
; ELF-NEXT:    ldp x30, x19, [sp, #16] // 16-byte Folded Reload
; ELF-NEXT:    ldr w0, [x8]
; ELF-NEXT:    add sp, sp, #32
; ELF-NEXT:    ret
; ELF-NEXT:  .LBB2_2: // %cold
; ELF-NEXT:    mov x19, x0
; ELF-NEXT:    add x0, sp, #12
; ELF-NEXT:    bl publish
; ELF-NEXT:    mov x0, x19
; ELF-NEXT:    b .LBB2_1
entry:
  %a = alloca i32
  %c = icmp eq i32 %n, 42
  br i1 %c, label %cold, label %join, !prof !0

cold:
  call void @publish(ptr %a)
  br label %join

join:
  %p = load ptr, ptr %pp
  %v = load i32, ptr %p
  ret i32 %v
}

; A guarded thread-local access: the block after the initializer's call loads
; through a pointer derived from the thread pointer. The two values live
; across the call are spilled or loaded again around it.
@desc = external constant { ptr, i32, i32 }

define i32 @guarded_tls() {
; ELF-LABEL: guarded_tls:
; ELF:       // %bb.0: // %entry
; ELF-NEXT:    adrp x8, :got:desc
; ELF-NEXT:    ldr x8, [x8, :got_lo12:desc]
; ELF-NEXT:    ldr x9, [x8]
; ELF-NEXT:    ldr w9, [x9]
; ELF-NEXT:    mrs x10, TPIDR_EL0
; ELF-NEXT:    ldr x9, [x10, x9, lsl #3]
; ELF-NEXT:    ldr w10, [x8, #12]
; ELF-NEXT:    ldrb w10, [x9, x10]
; ELF-NEXT:    cbz w10, .LBB3_2
; ELF-NEXT:  .LBB3_1: // %join
; ELF-NEXT:    ldr w8, [x8, #8]
; ELF-NEXT:    ldr w0, [x9, x8]
; ELF-NEXT:    ret
; ELF-NEXT:  .LBB3_2: // %cold
; ELF-NEXT:    stp x30, x9, [sp, #-16]! // 16-byte Folded Spill
; ELF-NEXT:    .cfi_def_cfa_offset 16
; ELF-NEXT:    .cfi_offset w30, -16
; ELF-NEXT:    bl init
; ELF-NEXT:    adrp x8, :got:desc
; ELF-NEXT:    ldr x9, [sp, #8] // 8-byte Reload
; ELF-NEXT:    ldr x8, [x8, :got_lo12:desc]
; ELF-NEXT:    ldr x30, [sp], #16 // 8-byte Folded Reload
; ELF-NEXT:    b .LBB3_1
entry:
  %0 = load ptr, ptr @desc, !invariant.load !1
  %1 = load i32, ptr %0, !invariant.load !1
  %2 = call ptr @llvm.thread.pointer.p0()
  %3 = zext i32 %1 to i64
  %4 = getelementptr inbounds [8 x i8], ptr %2, i64 %3
  %5 = load ptr, ptr %4
  %6 = load i32, ptr getelementptr inbounds (i8, ptr @desc, i64 12), !invariant.load !1
  %7 = zext i32 %6 to i64
  %8 = getelementptr inbounds i8, ptr %5, i64 %7
  %9 = load i8, ptr %8
  %10 = icmp eq i8 %9, 0
  br i1 %10, label %cold, label %join, !prof !0

cold:
  call void @init()
  br label %join

join:
  %11 = load i32, ptr getelementptr inbounds (i8, ptr @desc, i64 8), !invariant.load !1
  %12 = zext i32 %11 to i64
  %13 = getelementptr inbounds i8, ptr %5, i64 %12
  %14 = load i32, ptr %13
  ret i32 %14
}

declare ptr @llvm.thread.pointer.p0()

!0 = !{!"branch_weights", i32 1, i32 2000}
!1 = !{}
