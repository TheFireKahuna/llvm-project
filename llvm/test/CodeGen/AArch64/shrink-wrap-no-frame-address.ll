; A load through a pointer of unknown origin reaches the function's frame only
; where an address in the frame was formed. With no such address, a call on a
; cold path is the only code that needs the frame, which is set up there.

declare void @slow(i32)
declare void @slow_i64(i64)
declare void @publish(ptr)
declare void @init()

define i32 @deref2(ptr %pp, i32 %n) {
; ELF-LABEL: deref2:
; ELF:       // %bb.0: // %entry
; ELF-NEXT:    cmp w1, #42
; ELF-NEXT:    b.eq .LBB0_2
; ELF-NEXT:  .LBB0_1: // %join
; ELF-NEXT:    ldr x8, [x0]
; ELF-NEXT:    ldr w0, [x8]
; ELF-NEXT:    ret
; ELF-NEXT:  .LBB0_2: // %cold
; ELF-NEXT:    stp x30, x0, [sp, #-16]! // 16-byte Folded Spill
; ELF-NEXT:    .cfi_def_cfa_offset 16
; ELF-NEXT:    .cfi_offset w30, -16
; ELF-NEXT:    mov w0, #42 // =0x2a
; ELF-NEXT:    bl slow
; ELF-NEXT:    ldr x0, [sp, #8] // 8-byte Reload
; ELF-NEXT:    ldr x30, [sp], #16 // 8-byte Folded Reload
; ELF-NEXT:    b .LBB0_1
entry:
  %c = icmp eq i32 %n, 42
  br i1 %c, label %cold, label %join, !prof !0

cold:
  call void @slow(i32 42)
  br label %join

join:
  %p = load ptr, ptr %pp
  %v = load i32, ptr %p
  ret i32 %v
}

