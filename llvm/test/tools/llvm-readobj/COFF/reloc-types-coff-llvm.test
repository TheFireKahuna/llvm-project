      - { VirtualAddress: 0, Type: IMAGE_REL_LLVM_FUSED_ACCESS }
      - { VirtualAddress: 0, Type: IMAGE_REL_LLVM_FUSED_INDEX }
      - { VirtualAddress: 0, SymbolTableIndex: 516, Type: IMAGE_REL_LLVM_FUSED_ADD }
