; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --function-signature
; RUN: opt -passes=argpromotion -verify-each -S < %s | FileCheck %s

target triple = "x86_64-unknown-linux-gnu"

declare void @observe(ptr)
declare void @may_throw()
declare i32 @personality(...)

; Computation and control flow do not prevent output promotion. The last store
; must execute on every normal return, and must not move across an observation.
define internal void @computed(ptr %out, i32 %x) noinline {
; CHECK-LABEL: define {{[^@]+}}@computed
; CHECK-SAME: (i32 [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[V:%.*]] = mul i32 [[X]], 7
; CHECK-NEXT:    ret i32 [[V]]
;
  %v = mul i32 %x, 7
  store i32 %v, ptr %out, align 1
  ret void
}

define void @call_computed(ptr %out, i32 %x) {
; CHECK-LABEL: define {{[^@]+}}@call_computed
; CHECK-SAME: (ptr [[OUT:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = tail call i32 @computed(i32 [[X]])
; CHECK-NEXT:    store i32 [[TMP1]], ptr [[OUT]], align 1
; CHECK-NEXT:    ret void
;
  tail call void @computed(ptr %out, i32 %x)
  ret void
}

define internal void @diamond(ptr %out, i32 %x, i1 %c) {
; CHECK-LABEL: define {{[^@]+}}@diamond
; CHECK-SAME: (i32 [[X:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:    br i1 [[C]], label [[LEFT:%.*]], label [[RIGHT:%.*]]
; CHECK:       left:
; CHECK-NEXT:    [[A:%.*]] = add i32 [[X]], 1
; CHECK-NEXT:    br label [[EXIT:%.*]]
; CHECK:       right:
; CHECK-NEXT:    [[B:%.*]] = mul i32 [[X]], 3
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ [[A]], [[LEFT]] ], [ [[B]], [[RIGHT]] ]
; CHECK-NEXT:    ret i32 [[V]]
;
  br i1 %c, label %left, label %right
left:
  %a = add i32 %x, 1
  br label %exit
right:
  %b = mul i32 %x, 3
  br label %exit
exit:
  %v = phi i32 [ %a, %left ], [ %b, %right ]
  store i32 %v, ptr %out, align 4
  ret void
}

define void @call_diamond(ptr %out, i32 %x, i1 %c) {
; CHECK-LABEL: define {{[^@]+}}@call_diamond
; CHECK-SAME: (ptr [[OUT:%.*]], i32 [[X:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @diamond(i32 [[X]], i1 [[C]])
; CHECK-NEXT:    store i32 [[TMP1]], ptr [[OUT]], align 4
; CHECK-NEXT:    ret void
;
  call void @diamond(ptr %out, i32 %x, i1 %c)
  ret void
}

; The input and output may alias: the load must still precede the store.
define internal void @alias(ptr %out, ptr %in) {
; CHECK-LABEL: define {{[^@]+}}@alias
; CHECK-SAME: (i32 [[IN_0_VAL:%.*]]) {
; CHECK-NEXT:    ret i32 [[IN_0_VAL]]
;
  %v = load i32, ptr %in, align 1
  store i32 %v, ptr %out, align 2
  ret void
}

define void @call_alias(ptr %p) {
; CHECK-LABEL: define {{[^@]+}}@call_alias
; CHECK-SAME: (ptr [[P:%.*]]) {
; CHECK-NEXT:    [[P_VAL:%.*]] = load i32, ptr [[P]], align 1
; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @alias(i32 [[P_VAL]])
; CHECK-NEXT:    store i32 [[TMP1]], ptr [[P]], align 2
; CHECK-NEXT:    ret void
;
  call void @alias(ptr %p, ptr %p)
  ret void
}

; A throw before the final store must still leave the destination unchanged.
