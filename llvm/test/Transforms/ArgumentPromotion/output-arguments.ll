; CHECK-NEXT:    call void @may_throw()
; CHECK-NEXT:    ret i32 [[V]]
;
  call void @may_throw()
  store i32 %v, ptr %out, align 4
  ret void
}

define void @call_throw_before(ptr %out, i32 %v) {
