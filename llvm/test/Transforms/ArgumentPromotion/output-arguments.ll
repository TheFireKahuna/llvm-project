define void @negative_calls(ptr %p, i32 %v, i1 %c) {
; CHECK-LABEL: define {{[^@]+}}@negative_calls
; CHECK-SAME: (ptr [[P:%.*]], i32 [[V:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:    call void @read_output(ptr [[P]])
; CHECK-NEXT:    call void @observed(ptr [[P]], i32 [[V]])
; CHECK-NEXT:    call void @captured(ptr [[P]], i32 [[V]])
; CHECK-NEXT:    call void @conditional(ptr [[P]], i32 [[V]], i1 [[C]])
; CHECK-NEXT:    call void @volatile_output(ptr [[P]], i32 [[V]])
; CHECK-NEXT:    call void @atomic_output(ptr [[P]], i32 [[V]])
; CHECK-NEXT:    [[R:%.*]] = call i32 @nonvoid(ptr [[P]], i32 [[V]])
; CHECK-NEXT:    call void @offset_output(ptr [[P]], i32 [[R]])
; CHECK-NEXT:    ret void
;
  call void @read_output(ptr %p)
  call void @observed(ptr %p, i32 %v)
  call void @captured(ptr %p, i32 %v)
  call void @conditional(ptr %p, i32 %v, i1 %c)
  call void @volatile_output(ptr %p, i32 %v)
  call void @atomic_output(ptr %p, i32 %v)
  %r = call i32 @nonvoid(ptr %p, i32 %v)
  call void @offset_output(ptr %p, i32 %r)
  ret void
}

; A byval write is private to the callee; it must not become a caller store.
define internal void @byval_output(ptr byval(i32) align 4 %out, i32 %v) {
; CHECK-LABEL: define {{[^@]+}}@byval_output
; CHECK-SAME: (i32 [[OUT_0_VAL:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:    ret void
;
  store i32 %v, ptr %out, align 4
  ret void
}

