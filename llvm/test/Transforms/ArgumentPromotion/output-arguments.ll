; CHECK-SAME: (ptr [[OUT:%.*]], <4 x i32> [[V:%.*]]) #[[ATTR1]] {
; CHECK-NEXT:    [[TMP1:%.*]] = call <4 x i32> @vector_output(<4 x i32> [[V]])
; CHECK-NEXT:    store <4 x i32> [[TMP1]], ptr [[OUT]], align 16, !nontemporal [[META0:![0-9]+]]
; CHECK-NEXT:    ret void
;
  call void @vector_output(ptr %out, <4 x i32> %v)
  ret void
}

