; CHECK-SAME: (ptr [[OUT:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @throw_before(i32 [[V]])
; CHECK-NEXT:    store i32 [[TMP1]], ptr [[OUT]], align 4
; CHECK-NEXT:    ret void
;
  call void @throw_before(ptr %out, i32 %v)
