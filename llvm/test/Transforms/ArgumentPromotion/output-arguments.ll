; CHECK-SAME: (ptr [[OUT:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:    [[OUT_VAL:%.*]] = load i32, ptr [[OUT]], align 4
; CHECK-NEXT:    call void @byval_output(i32 [[OUT_VAL]], i32 [[V]])
; CHECK-NEXT:    ret void
;
  call void @byval_output(ptr byval(i32) align 4 %out, i32 %v)
  ret void
}

; All callers must be supported, including a mixture of calls and invokes.
define internal void @invoked(ptr %out, i32 %v) {
; CHECK-LABEL: define {{[^@]+}}@invoked
; CHECK-SAME: (ptr [[OUT:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:    store i32 [[V]], ptr [[OUT]], align 4
; CHECK-NEXT:    ret void
;
  store i32 %v, ptr %out, align 4
  ret void
}

define void @call_invoked(ptr %out, i32 %v) personality ptr @personality {
; CHECK-LABEL: define {{[^@]+}}@call_invoked
; CHECK-SAME: (ptr [[OUT:%.*]], i32 [[V:%.*]]) personality ptr @personality {
; CHECK-NEXT:    call void @invoked(ptr [[OUT]], i32 [[V]])
; CHECK-NEXT:    invoke void @invoked(ptr [[OUT]], i32 [[V]])
; CHECK-NEXT:            to label [[NORMAL:%.*]] unwind label [[EXCEPTION:%.*]]
; CHECK:       normal:
; CHECK-NEXT:    ret void
; CHECK:       exception:
; CHECK-NEXT:    [[LP:%.*]] = landingpad { ptr, i32 }
; CHECK-NEXT:            cleanup
; CHECK-NEXT:    resume { ptr, i32 } [[LP]]
;
  call void @invoked(ptr %out, i32 %v)
  invoke void @invoked(ptr %out, i32 %v) to label %normal unwind label %exception
normal:
  ret void
exception:
  %lp = landingpad { ptr, i32 } cleanup
  resume { ptr, i32 } %lp
}

