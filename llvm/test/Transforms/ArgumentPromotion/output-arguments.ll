; Preserve non-temporal intent and propagate vector-width requirements even
; when the output value was already passed by value.
define internal void @vector_output(ptr %out, <4 x i32> %v) #0 {
; CHECK-LABEL: define {{[^@]+}}@vector_output
; CHECK-SAME: (<4 x i32> [[V:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    ret <4 x i32> [[V]]
;
  store <4 x i32> %v, ptr %out, align 16, !nontemporal !0
  ret void
}

