; CHECK-NEXT:    [[P_VAL:%.*]] = load i128, ptr [[P]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = call i128 @move16(i128 [[P_VAL]])
; CHECK-NEXT:    store i128 [[TMP1]], ptr [[DST]], align 1
; CHECK-NEXT:    [[P_VAL1:%.*]] = load i128, ptr [[P]], align 8
