; Returning the copied value exposes a load to the existing input promotion.
; No caller loop or ownership type is required, and noinline is preserved.
define internal void @copy16(ptr %dst, ptr %src) noinline {
; CHECK-LABEL: define {{[^@]+}}@copy16
; CHECK-SAME: (i128 [[SRC_0_VAL:%.*]]) #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:    ret i128 [[SRC_0_VAL]]
;
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %dst, ptr align 1 %src, i64 16, i1 false)
  ret void
}

define void @call_copy16(ptr %dst, ptr %src) {
; CHECK-LABEL: define {{[^@]+}}@call_copy16
; CHECK-SAME: (ptr [[DST:%.*]], ptr [[SRC:%.*]]) {
; CHECK-NEXT:    [[SRC_VAL:%.*]] = load i128, ptr [[SRC]], align 1
; CHECK-NEXT:    [[TMP1:%.*]] = call i128 @copy16(i128 [[SRC_VAL]])
; CHECK-NEXT:    store i128 [[TMP1]], ptr [[DST]], align 4
; CHECK-NEXT:    ret void
;
  call void @copy16(ptr %dst, ptr %src)
  ret void
}

