# XML: <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
# XML-NOT: <heapType
# RESOURCE: Total Number of Resources: 1
# RESOURCE: Type: MANIFEST (ID 24)
# RESOURCE: Name: (ID 1)
# CONFLICT: conflicting application heapType: expected SegmentHeap
# NAMESPACE: invalid application heapType element or namespace
# DTD: DTD is not supported with a required application heapType
# EMBED: segment heap requires /manifest:embed
# ID: segment heap requires manifest resource ID 1
# DLL: segment heap selection requires an executable
# LANG: multiple application manifest languages with segment heap

#--- same.xml
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
#--- conflict.xml
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">win32Compatible</heapType>
    </windowsSettings>
  </application>
</assembly>
#--- wrong-namespace.xml
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings><heapType>SegmentHeap</heapType></windowsSettings>
  </application>
</assembly>
#--- prefixed.xml
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <a:application xmlns:a="urn:schemas-microsoft-com:asm.v3">
    <a:windowsSettings>
      <h:heapType xmlns:h="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</h:heapType>
    </a:windowsSettings>
  </a:application>
</assembly>
#--- dtd.xml
<!DOCTYPE assembly [<!ENTITY heap "SegmentHeap">]>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">&heap;</heapType>
    </windowsSettings>
  </application>
</assembly>
