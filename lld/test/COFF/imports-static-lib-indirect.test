# REQUIRES: x86

# A member pulled in for one symbol also satisfies a dllimport reference to
# another of its symbols; the indirect call is rewritten to a direct one, so
# there is nothing to warn about.
# RUN: split-file %s %t.dir
# RUN: llvm-mc --filetype=obj -triple=x86_64-windows-msvc %t.dir/other.s -o %t.other.obj
# RUN: llvm-mc --filetype=obj -triple=x86_64-windows-msvc %t.dir/main.s -o %t.main.obj
# RUN: llvm-lib %t.other.obj -out:%t.other.lib
# RUN: lld-link %t.other.lib %t.main.obj -out:%t.dll -dll -debug:symtab 2>&1 | FileCheck --allow-empty --check-prefix=QUIET %s
# RUN: llvm-objdump -d --no-show-raw-insn %t.dll | FileCheck %s

QUIET-NOT: {{.}}

CHECK:      <_DllMainCRTStartup>:
CHECK-NEXT:   callq *0x{{[0-9a-f]+}}(%rip)
CHECK-NEXT:   addr32 callq 0x{{[0-9a-f]+}} <foo>

#--- other.s
.text
.globl other
.globl foo
other:
  ret
foo:
  ret
#--- main.s
.text
.global _DllMainCRTStartup
_DllMainCRTStartup:
  call *other(%rip)
  call *__imp_foo(%rip)
  ret
