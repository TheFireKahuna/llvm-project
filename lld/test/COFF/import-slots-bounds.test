# REQUIRES: x86

# Validate the complete native import destination before reading the addend.
# A truncated pointer must not become a zero-addend import that lets the loader
# overwrite the next contribution. Check the subtraction at both boundaries,
# including an offset whose addition would overflow a 32-bit integer.

# RUN: split-file %s %t
# RUN: llvm-dlltool -m i386:x86-64 -d %t/lib.def -l %t/64.lib
# RUN: llvm-dlltool -m i386 -d %t/lib.def -l %t/32.lib
# RUN: yaml2obj %t/slot.yaml -o %t/valid.obj
# RUN: lld-link -dll -noentry -import-slots -out:%t/valid.dll %t/valid.obj %t/64.lib
# RUN: yaml2obj %t/slot.yaml -DOFFSET=4 -o %t/short.obj
# RUN: env LLD_IN_TEST=1 not lld-link -dll -noentry -import-slots -out:%t/short.dll %t/short.obj %t/64.lib 2>&1 | FileCheck %s --check-prefix=SHORT
# RUN: yaml2obj %t/slot.yaml -DOFFSET=8 -o %t/end.obj
# RUN: env LLD_IN_TEST=1 not lld-link -dll -noentry -import-slots -out:%t/end.dll %t/end.obj %t/64.lib 2>&1 | FileCheck %s --check-prefix=END
# RUN: yaml2obj %t/slot.yaml -DOFFSET=4294967295 -o %t/overflow.obj
# RUN: env LLD_IN_TEST=1 not lld-link -dll -noentry -import-slots -out:%t/overflow.dll %t/overflow.obj %t/64.lib 2>&1 | FileCheck %s --check-prefix=OVERFLOW
# RUN: yaml2obj %t/slot.yaml -DMACHINE=IMAGE_FILE_MACHINE_I386 -DRELOC=IMAGE_REL_I386_DIR32 -DSYMBOL=_variable -DDATA=00000000 -o %t/valid32.obj
# RUN: lld-link -dll -noentry -import-slots -safeseh:no -out:%t/valid32.dll %t/valid32.obj %t/32.lib
# RUN: yaml2obj %t/slot.yaml -DMACHINE=IMAGE_FILE_MACHINE_I386 -DRELOC=IMAGE_REL_I386_DIR32 -DSYMBOL=_variable -DDATA=00000000 -DOFFSET=2 -o %t/short32.obj
# RUN: env LLD_IN_TEST=1 not lld-link -dll -noentry -import-slots -safeseh:no -out:%t/short32.dll %t/short32.obj %t/32.lib 2>&1 | FileCheck %s --check-prefix=SHORT32

# SHORT: error: {{.*}}short.obj: 8-byte import slot at offset 4 extends beyond section .rdata of size 8
# END: error: {{.*}}end.obj: 8-byte import slot at offset 8 extends beyond section .rdata of size 8
# OVERFLOW: error: {{.*}}overflow.obj: 8-byte import slot at offset 4294967295 extends beyond section .rdata of size 8
# SHORT32: error: {{.*}}short32.obj: 4-byte import slot at offset 2 extends beyond section .rdata of size 4

#--- lib.def
LIBRARY slots.dll
EXPORTS
variable DATA

#--- slot.yaml
--- !COFF
header:
  Machine: '[[MACHINE=IMAGE_FILE_MACHINE_AMD64]]'
sections:
  - Name: .rdata
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ ]
    Alignment: 8
    SectionData: '[[DATA=0000000000000000]]'
    Relocations:
      - VirtualAddress: '[[OFFSET=0]]'
        SymbolName: '[[SYMBOL=variable]]'
        Type: '[[RELOC=IMAGE_REL_AMD64_ADDR64]]'
symbols:
  - Name: '[[SYMBOL=variable]]'
    Value: 0
    SectionNumber: 0
    SimpleType: IMAGE_SYM_TYPE_NULL
    ComplexType: IMAGE_SYM_DTYPE_NULL
    StorageClass: IMAGE_SYM_CLASS_EXTERNAL
...
