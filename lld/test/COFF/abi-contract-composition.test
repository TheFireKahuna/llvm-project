# REQUIRES: x86
# RUN: split-file %s %t
# RUN: %python %t/input.py %t
# RUN: llc -filetype=obj %t/a.ll -o %t/a.obj
# RUN: llc -filetype=obj %t/b.ll -o %t/b.obj
# RUN: llc -filetype=obj %t/provider.ll -o %t/provider.obj
# RUN: llc -filetype=obj %t/incomplete.ll -o %t/incomplete.obj
# RUN: llvm-as %t/a.ll -o %t/a.bc
# RUN: llvm-as %t/b.ll -o %t/b.bc
# RUN: llvm-as %t/provider.ll -o %t/provider.bc
# RUN: opt -module-summary %t/a.ll -o %t/a.thin.bc
# RUN: opt -module-summary %t/b.ll -o %t/b.thin.bc
# RUN: opt -module-summary %t/provider.ll -o %t/provider.thin.bc
# RUN: lld-link /dll /noentry /import-slots /out:%t/native.dll %t/a.obj %t/b.obj %t/provider.obj
# RUN: lld-link /dll /noentry /import-slots /out:%t/reverse.dll %t/b.obj %t/a.obj %t/provider.obj
# RUN: lld-link /dll /noentry /import-slots /out:%t/full.dll %t/a.bc %t/b.bc %t/provider.bc
# RUN: lld-link /dll /noentry /import-slots /out:%t/thin.dll %t/a.thin.bc %t/b.thin.bc %t/provider.thin.bc
# RUN: %python %t/check.py %t
# RUN: env LLD_IN_TEST=1 not lld-link /dll /noentry /import-slots /out:%t/bad.dll %t/a.obj %t/b.obj %t/incomplete.obj 2>&1 | FileCheck %s
# CHECK: definition of entity
# CHECK-SAME: does not satisfy its physical ABI requirement

# Consumers contribute complementary original requirements, with no surviving
# address uses. Composition must precede provider selection and work with native
# records, full LTO and ThinLTO. A provider that offers only half the composed
# contract fails even though neither consumer contradicts it individually.

#--- input.py
import pathlib
import sys

root = pathlib.Path(sys.argv[1])

def node(kind, name, properties, edges=()):
    # This fixture uses only one-byte ULEBs.
    result = bytes([kind, 0, len(name)]) + name.encode()
    result += bytes([len(properties), *properties, len(edges)])
    for role, target, props in edges:
        result += bytes([role, target, len(props), *props])
    return result

def contract(complete):
    result = bytes([1, 3])
    result += node(8, 'Root', [16, 8, 16, 16, 8, 0],
                   [(4, 1, [0, 0, 0, 0]), (4, 2, [1, 64, 0, 0])])
    for i, name in enumerate(['A', 'B']):
        result += node(8, name, [8, 8, 8, 8, 8, 0]) if complete & (1 << i) else node(0, name, [])
    return result

for name, complete in [('a', 1), ('b', 2), ('provider', 3), ('incomplete', 1)]:
    encoded = contract(complete)
    (root / (name + '.contract')).write_bytes(encoded)
    escaped = ''.join('\\%02X' % b for b in encoded)
    ir = '''
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-windows-itanium"
'''
    if name in ['provider', 'incomplete']:
        ir += '''
$entity = comdat any
@entity = linkonce_odr constant [2 x ptr] zeroinitializer, comdat, !coff.binding !1, !coff.abi !2
'''
    else:
        ir += '''
@entity = external constant [2 x ptr], !coff.binding !1
define dllexport i64 @''' + name + '''() !coff.abi.uses !3 {
  ret i64 8
}
!3 = !{!4}
!4 = !{ptr @entity, !"''' + escaped + '''"}
'''
    ir += '''
!llvm.module.flags = !{!0}
!0 = !{i32 1, !"coff.rtti_abi", i32 2}
!1 = !{i32 3}
!2 = !{!"''' + escaped + '''"}
'''
    (root / (name + '.ll')).write_text(ir)

#--- check.py
import base64
import hashlib
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
digest = base64.urlsafe_b64encode(hashlib.sha256(
    (root / 'provider.contract').read_bytes()).digest()).rstrip(b'=')
qualified = b'entity$abi$1$' + digest + b'\0'
for name in ['native', 'reverse', 'full', 'thin']:
    image = (root / (name + '.dll')).read_bytes()
    assert image.count(qualified) == 1, name
providers = list(root.glob('rtti2-*.dll'))
assert len(providers) == 1
assert qualified in providers[0].read_bytes()
