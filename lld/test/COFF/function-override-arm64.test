REQUIRES: aarch64
RUN: split-file %s %t.dir && cd %t.dir
RUN: llvm-mc -filetype=obj -triple=aarch64-windows fo.s -o fo.obj
RUN: llvm-mc -filetype=obj -triple=aarch64-windows main.s -o main.obj
RUN: llvm-mc -filetype=obj -triple=aarch64-windows %S/Inputs/loadconfig-arm64.s -o loadconfig.obj

A BRANCH26 states a branch, so each to X is a site of X's record, as the
stub's own branch is, and branches to the default body; other references
take the stub, unless they have an addend.
Microsoft's ARM64 objects define X_$fo_default$ as an absolute 0, and the
record's original RVA is X's body.

RUN: lld-link -machine:arm64 -funcoverride -entry:main -out:out.exe main.obj fo.obj loadconfig.obj
RUN: llvm-readobj --coff-load-config out.exe | FileCheck %s
RUN: llvm-objdump -d -s --no-show-raw-insn out.exe | FileCheck --check-prefix=DISASM %s

CHECK:      FunctionOverride [
CHECK-NEXT:   Entry {
CHECK-NEXT:     OriginalRVA: 0x1020
CHECK-NEXT:     RVAs [
CHECK-NEXT:       RVA: 0x1030
CHECK-NEXT:     ]
CHECK-NEXT:     Fixups [
CHECK-NEXT:       Fixup {
CHECK-NEXT:         Type: ARM64_BRANCH26
CHECK-NEXT:         RVA: 0x1000
CHECK-NEXT:       }
CHECK-NEXT:       Fixup {
CHECK-NEXT:         Type: ARM64_BRANCH26
CHECK-NEXT:         RVA: 0x1004
CHECK-NEXT:       }
CHECK-NEXT:       Fixup {
CHECK-NEXT:         Type: ARM64_BRANCH26
CHECK-NEXT:         RVA: 0x1040
CHECK-NEXT:       }
CHECK-NEXT:     ]

DISASM:      Contents of section .data:
DISASM-NEXT:  140003000 40100040 01000000
DISASM:      140001000: bl 0x140001020
DISASM-NEXT: 140001004: b 0x140001020
DISASM-NEXT: 140001008: adrp x0, 0x140001000
DISASM-NEXT: 14000100c: add x0, x0, #0x40
DISASM-NEXT: 140001010: adrp x1, 0x140001000
DISASM-NEXT: 140001014: add x1, x1, #0x28
DISASM:      140001040: b 0x140001020

Windows writes a site's displacement without checking its range.

RUN: llvm-mc -filetype=obj -triple=aarch64-windows fo.s --defsym FAR=1 -o far.obj
RUN: llvm-mc -filetype=obj -triple=aarch64-windows --defsym FAR=1 main.s -o mainfar.obj
RUN: not lld-link -machine:arm64 -funcoverride -entry:main -out:err.exe mainfar.obj far.obj loadconfig.obj 2>&1 \
RUN:   | FileCheck --check-prefix=RANGE %s
RANGE: error: function override X: candidate far is out of range of the branch at RVA 0x1000

An object that LLVM made for Windows Itanium or NT-POSIX is read with no
option. Its function f is the compiler's stub, a branch to the default body
X, which takes no stub of the link's. The bl to f, the call through f's
pointer, which the link makes a bl, and the b to f reach X as sites, as the
stub's own branch is one; the b that ends its section before X's stays.
f's address keeps the stub.

RUN: llvm-mc -filetype=obj -triple=aarch64-windows-itanium fork.s -o fork.obj
RUN: lld-link -machine:arm64 -entry:main -debug:symtab -out:fork.exe fork.obj loadconfig.obj
RUN: llvm-readobj --coff-load-config fork.exe | FileCheck --check-prefix=FORK %s
RUN: llvm-objdump -d --no-show-raw-insn fork.exe | FileCheck --check-prefix=FORK-DISASM %s
RUN: llvm-mc -filetype=obj -triple=aarch64-windows-itanium --defsym FAR=1 fork.s -o forkfar.obj
RUN: not lld-link -machine:arm64 -entry:main -out:err.exe forkfar.obj loadconfig.obj 2>&1 \
RUN:   | FileCheck --check-prefix=FORK-RANGE %s

FORK:      OriginalRVA: 0x1010
FORK-NEXT: RVAs [
FORK-NEXT:   RVA: 0x1018
FORK-NEXT: ]
FORK:          RVA: 0x1000
FORK:          RVA: 0x1004
FORK:          RVA: 0x100C
FORK:          RVA: 0x1014
FORK-NOT:  RVA:

FORK-DISASM:      <main>:
FORK-DISASM-NEXT: 140001000: bl 0x140001010 <X>
FORK-DISASM-NEXT: 140001004: bl 0x140001010 <X>
FORK-DISASM-NEXT: 140001008: adr x0, 0x140001014 <f>
FORK-DISASM-NEXT: 14000100c: b 0x140001010 <X>
FORK-DISASM:      <f>:
FORK-DISASM-NEXT: 140001014: b 0x140001010 <X>

FORK-RANGE: error: function override X: candidate c1 is out of range of the branch at RVA 0x1000

#--- main.s
  .text
  .globl main
main:
  bl X
  b X
  adrp x0, X
  add x0, x0, :lo12:X
  adrp x1, X + 8
  add x1, x1, :lo12:X + 8

  .section .text$mn,"xr",one_only,X
  .globl X
  .p2align 4
X:
  mov w0, #1
  ret
  .globl "X_$fo_default$"
  .set "X_$fo_default$", 0

  .section .text$mn,"xr",one_only,c1
  .globl c1
  .p2align 4
c1:
  mov w0, #2
  ret

  .data
  .xword X

.ifdef FAR
  .section .text2,"xr"
  .space 0x8000000
  .globl far
far:
  ret
.endif

#--- fo.s
  .section "X_$fo_bdd$","dr"
  .long 1, 0x18
  .short 2, 1, 0xc, 1, 1, 1
  .zero 12
  .section "X_$fo_rvas$","dr"
  .globl "X_$fo_rvas$"
.ifdef FAR
  .rva far
.else
  .rva c1
.endif

#--- fork.s
  .text
  .globl main
main:
  bl f
  adrp x8, __imp_f
  ldr x8, [x8, :fused_lo12:__imp_f]
  .reloc ., IMAGE_REL_LLVM_FUSED_CALL, __imp_f
  blr x8
  adrp x0, f
  add x0, x0, :lo12:f
  b f

  .section .text$t,"xr",discard,X
  .globl X
X:
  ret

  .section .text$t,"xr",discard,f
  .globl f
f:
  b X

.ifdef FAR
  .section .text2,"xr"
  .space 0x8000000
.else
  .section .text$t,"xr",discard,c1
.endif
  .globl c1
c1:
  ret

## The sections as the compiler writes them: COMDATs, the candidates' with
## the diagram's, which X_$fo$ begins.
  .section "X_$fo_bdd$","y",discard,"X_$fo$"
  .globl "X_$fo$"
"X_$fo$":
  .long 1, 0x18
  .short 2, 1, 0xc, 1, 1, 1
  .zero 12
  .section "X_$fo_rvas$","y",associative,"X_$fo$"
  bl c1
