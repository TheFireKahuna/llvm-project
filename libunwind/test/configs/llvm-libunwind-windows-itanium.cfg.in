#
# Configuration file for running the libunwind tests against the shared
# library (libunwind.dll) on Windows Itanium / NT-POSIX.
#
# Same shape as llvm-libunwind-shared.cfg.in, minus the ELF-isms (rpath,
# -ldl, --export-dynamic). PE has no rpath, so the DLL directory of the
# test-suite install must be prepended to PATH for the executor instead.
#

lit_config.load_config(config, '@CMAKE_CURRENT_BINARY_DIR@/cmake-bridge.cfg')

compile_flags = []

if @LIBUNWIND_ENABLE_CET@:
    compile_flags.append('-fcf-protection=full')

# Stack unwinding tests need unwinding tables and these are not generated by default on all targets.
compile_flags.append('-funwind-tables')

config.substitutions.append(('%{flags}', ''))
config.substitutions.append(('%{compile_flags}',
    '-nostdinc++ -I %{{include}} {}'.format(' '.join(compile_flags))
))
config.substitutions.append(('%{link_flags}',
    '-L %{lib} -lunwind'
))
config.substitutions.append(('%{exec}',
    '%{executor} --execdir %{temp} --prepend_env PATH=%{install-prefix}/bin -- '
))

import os, site
site.addsitedir(os.path.join('@LIBUNWIND_LIBCXX_PATH@', 'utils'))
import libcxx.test.params, libcxx.test.config
libcxx.test.config.configure(
    libcxx.test.params.DEFAULT_PARAMETERS,
    libcxx.test.features.DEFAULT_FEATURES,
    config,
    lit_config
)
