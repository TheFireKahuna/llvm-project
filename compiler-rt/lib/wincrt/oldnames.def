LIBRARY ucrtbase.dll
EXPORTS
    ; The POSIX and other traditional names of Universal CRT functions, each
    ; importing the function under the name ucrtbase.dll exports, so that
    ; they link with no wrapper code, as oldnames.lib gives Visual C++. The
    ; data names (timezone, daylight, tzname and the like) cannot be
    ; imported under another name and are not listed.
    access EXPORTAS _access
    cgets EXPORTAS _cgets
    chdir EXPORTAS _chdir
    chmod EXPORTAS _chmod
    chsize EXPORTAS _chsize
    close EXPORTAS _close
    cputs EXPORTAS _cputs
    creat EXPORTAS _creat
    cwait EXPORTAS _cwait
    dup EXPORTAS _dup
    dup2 EXPORTAS _dup2
    ecvt EXPORTAS _ecvt
    eof EXPORTAS _eof
    execl EXPORTAS _execl
    execle EXPORTAS _execle
    execlp EXPORTAS _execlp
    execlpe EXPORTAS _execlpe
    execv EXPORTAS _execv
    execve EXPORTAS _execve
    execvp EXPORTAS _execvp
    execvpe EXPORTAS _execvpe
    fcloseall EXPORTAS _fcloseall
    fcvt EXPORTAS _fcvt
    fdopen EXPORTAS _fdopen
    fgetchar EXPORTAS _fgetchar
    filelength EXPORTAS _filelength
    fileno EXPORTAS _fileno
    flushall EXPORTAS _flushall
    fputchar EXPORTAS _fputchar
    gcvt EXPORTAS _gcvt
    getch EXPORTAS _getch
    getche EXPORTAS _getche
    getcwd EXPORTAS _getcwd
    getpid EXPORTAS _getpid
    getw EXPORTAS _getw
    isascii EXPORTAS __isascii
    isatty EXPORTAS _isatty
    iscsym EXPORTAS __iscsym
    iscsymf EXPORTAS __iscsymf
    itoa EXPORTAS _itoa
    j0 EXPORTAS _j0
    j1 EXPORTAS _j1
    jn EXPORTAS _jn
    kbhit EXPORTAS _kbhit
    lfind EXPORTAS _lfind
    locking EXPORTAS _locking
    lsearch EXPORTAS _lsearch
    lseek EXPORTAS _lseek
    ltoa EXPORTAS _ltoa
    memccpy EXPORTAS _memccpy
    memicmp EXPORTAS _memicmp
    mkdir EXPORTAS _mkdir
    mktemp EXPORTAS _mktemp
    open EXPORTAS _open
    putch EXPORTAS _putch
    putenv EXPORTAS _putenv
    putw EXPORTAS _putw
    read EXPORTAS _read
    rmdir EXPORTAS _rmdir
    rmtmp EXPORTAS _rmtmp
    setmode EXPORTAS _setmode
    sopen EXPORTAS _sopen
    spawnl EXPORTAS _spawnl
    spawnle EXPORTAS _spawnle
    spawnlp EXPORTAS _spawnlp
    spawnlpe EXPORTAS _spawnlpe
    spawnv EXPORTAS _spawnv
    spawnve EXPORTAS _spawnve
    spawnvp EXPORTAS _spawnvp
    spawnvpe EXPORTAS _spawnvpe
    strcmpi EXPORTAS _stricmp
    strdup EXPORTAS _strdup
    stricmp EXPORTAS _stricmp
    strlwr EXPORTAS _strlwr
    strnicmp EXPORTAS _strnicmp
    strnset EXPORTAS _strnset
    strrev EXPORTAS _strrev
    strset EXPORTAS _strset
    strupr EXPORTAS _strupr
    swab EXPORTAS _swab
    tell EXPORTAS _tell
    tempnam EXPORTAS _tempnam
    toascii EXPORTAS __toascii
    tzset EXPORTAS _tzset
    ultoa EXPORTAS _ultoa
    umask EXPORTAS _umask
    ungetch EXPORTAS _ungetch
    unlink EXPORTAS _unlink
    wcsdup EXPORTAS _wcsdup
    wcsicmp EXPORTAS _wcsicmp
    wcsicoll EXPORTAS _wcsicoll
    wcslwr EXPORTAS _wcslwr
    wcsnicmp EXPORTAS _wcsnicmp
    wcsnset EXPORTAS _wcsnset
    wcsrev EXPORTAS _wcsrev
    wcsset EXPORTAS _wcsset
    wcsupr EXPORTAS _wcsupr
    write EXPORTAS _write
    y0 EXPORTAS _y0
    y1 EXPORTAS _y1
    yn EXPORTAS _yn
