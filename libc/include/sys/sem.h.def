#ifndef _LLVM_LIBC_SYS_SEM_H
#define _LLVM_LIBC_SYS_SEM_H

#if !defined(_WIN32) || defined(__NTPOSIX__)

#include "../__llvm-libc-common.h"
#include <sys/ipc.h>

%%public_api()

#endif // !defined(_WIN32) || defined(__NTPOSIX__)
#endif // _LLVM_LIBC_SYS_SEM_H

#if defined(_WIN32) && !defined(__NTPOSIX__) && __has_include_next(<sys/sem.h>)
#include_next <sys/sem.h>
#endif
