#ifndef LLVM_LIBC_SYS_SELECT_H
#define LLVM_LIBC_SYS_SELECT_H

#if !defined(_WIN32) || defined(__NTPOSIX__)

#include <signal.h>
#include <time.h>

%%public_api()

#endif // !defined(_WIN32) || defined(__NTPOSIX__)
