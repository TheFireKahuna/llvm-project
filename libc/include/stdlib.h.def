#ifndef LLVM_LIBC_STDLIB_H
#define LLVM_LIBC_STDLIB_H

#if !defined(_WIN32) || defined(__NTPOSIX__)

#include "__llvm-libc-common.h"
#include "llvm-libc-macros/stdlib-macros.h"
#include <sys/wait.h>

%%public_api()

#endif // !defined(_WIN32) || defined(__NTPOSIX__)
#endif // LLVM_LIBC_STDLIB_H

#if defined(_WIN32) && !defined(__NTPOSIX__) && __has_include_next(<stdlib.h>)
#include_next <stdlib.h>
#endif
