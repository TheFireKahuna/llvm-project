#ifndef LLVM_LIBC_PWD_H
#define LLVM_LIBC_PWD_H

#if !defined(_WIN32) || defined(__NTPOSIX__)

#include "__llvm-libc-common.h"

%%public_api()

#endif // !defined(_WIN32) || defined(__NTPOSIX__)
#endif // LLVM_LIBC_PWD_H

#if defined(_WIN32) && !defined(__NTPOSIX__) && __has_include_next(<pwd.h>)
#include_next <pwd.h>
#endif
