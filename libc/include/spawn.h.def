#ifndef LLVM_LIBC_SPAWN_H
#define LLVM_LIBC_SPAWN_H

#if !defined(_WIN32) || defined(__NTPOSIX__)

#include <signal.h>
#include <sched.h>

%%public_api()

#endif // !defined(_WIN32) || defined(__NTPOSIX__)
#endif // LLVM_LIBC_SPAWN_H

#if defined(_WIN32) && !defined(__NTPOSIX__) && __has_include_next(<spawn.h>)
#include_next <spawn.h>
#endif
