#ifndef _LLVM_LIBC_PTHREAD_H
#define _LLVM_LIBC_PTHREAD_H

#if !defined(_WIN32) || defined(__NTPOSIX__)

#include <time.h>

%%public_api()

#endif // !defined(_WIN32) || defined(__NTPOSIX__)
#endif // _LLVM_LIBC_PTHREAD_H

#if defined(_WIN32) && !defined(__NTPOSIX__) && __has_include_next(<pthread.h>)
#include_next <pthread.h>
#endif
