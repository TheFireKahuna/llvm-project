LIBRARY sspicli.dll
EXPORTS
    ; LSA authentication functions for S4U (Service-for-User) logon.
    ; Used by setuid/seteuid to acquire impersonation tokens for
    ; identity changes when running with SeTcbPrivilege.
    LsaConnectUntrusted
    LsaLookupAuthenticationPackage
    LsaLogonUser
    LsaFreeReturnBuffer
    LsaDeregisterLogonProcess
