; ole32.dll forwards CoInitializeEx/CoUninitialize to combase.dll via the
; api-ms-win-core-com-l1-1-0 API set, which resolves to combase.dll at load
; time. Linking directly against combase.dll avoids the extra indirection
; and matches how modern COM documentation describes the host DLL.

LIBRARY combase.dll
EXPORTS
    ; Apartment initialization / teardown
    CoInitializeEx
    CoUninitialize
    ; COM memory (used by SHGetKnownFolderPath via CoTaskMemFree)
    CoTaskMemAlloc
    CoTaskMemFree
    CoTaskMemRealloc
